{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": ["dist/", "node_modules/", "pnpm-lock.yaml", "*.tsbuildinfo", "**/generated/**"]
}
