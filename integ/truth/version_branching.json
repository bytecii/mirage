{
  "runs": {
    "python": {
      "command": [
        "./python/.venv/bin/python",
        "examples/python/version/branching.py"
      ]
    },
    "typescript": {
      "command": [
        "pnpm",
        "-C",
        "examples/typescript",
        "exec",
        "tsx",
        "version/branching.ts"
      ]
    }
  },
  "exit": 0,
  "lines": [
    "=== create workspace (ram mount) ===",
    "=== committed 'first' on main ===",
    "=== branched exp from main ===",
    "=== committed 'on exp' on exp ===",
    "=== committed 'second' on main ===",
    "=== log main ===",
    "second",
    "first",
    "=== log exp ===",
    "on exp",
    "first",
    "=== diff main exp ===",
    "added: b.txt",
    "modified: a.txt"
  ]
}
