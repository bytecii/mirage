        "ram-commands"
      ],
      "command": "pwd",
      "expect": {
        "exit": 127,
        "stdout": "",
        "stderr": "pwd: command not found\n"
      }
    },
    {
      "id": "cmd_listed_tool_runs",
      "seq": 923008,
      "targets": [
        "ram-commands"
      ],
      "command": "cat /scratch/locked/y",
      "expect": {
        "exit": 0,
        "stdout": "y\n",
