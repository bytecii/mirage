{
  "suite": "apple_container",
  "optional": true,
  "optional_reason": "Apple's container runs each container as a VM on Apple silicon with macOS 26 or later; GitHub-hosted macOS runners are themselves VMs without nested virtualization, so the container cannot run in CI. Run locally against `container run -d --name mirage-integ-apple debian:trixie-slim sleep infinity` with MIRAGE_INTEG_APPLE_CONTAINER=mirage-integ-apple (the unserved-cwd case pins dash's wording); drop this flag once the gate has such a host.",
  "requires": [
    "env:MIRAGE_INTEG_APPLE_CONTAINER"
  ],
  "cases": [
    {
      "id": "echo",
      "world": {
        "runtimes": [
          {
            "name": "apple_container",
            "captures": [
              "*"
            ],
            "config": {
              "container": "${MIRAGE_INTEG_APPLE_CONTAINER}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "echo hi-from-apple-container",
          "expect": {
            "exit": 0,
            "stdout": "hi-from-apple-container\n"
          }
        }
      ]
    },
    {
      "id": "exit_code",
      "world": {
        "runtimes": [
          {
            "name": "apple_container",
            "captures": [
              "*"
            ],
            "config": {
              "container": "${MIRAGE_INTEG_APPLE_CONTAINER}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "sh -c 'exit 7'",
          "expect": {
            "exit": 7
          }
        }
      ]
    },
    {
      "id": "stdin",
      "world": {
        "runtimes": [
          {
            "name": "apple_container",
            "captures": [
              "*"
            ],
            "config": {
              "container": "${MIRAGE_INTEG_APPLE_CONTAINER}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "wc -l",
          "stdin": "a\nb\nc\n",
          "expect": {
            "exit": 0,
            "stdout": "3\n"
          }
        }
      ]
    },
    {
      "id": "stderr",
      "world": {
        "runtimes": [
          {
            "name": "apple_container",
            "captures": [
              "*"
            ],
            "config": {
              "container": "${MIRAGE_INTEG_APPLE_CONTAINER}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "echo out; echo err >&2",
          "expect": {
            "exit": 0,
            "stdout": "out\n",
            "stderr": "err\n"
          }
        }
      ]
    },
    {
      "id": "config_env",
      "world": {
        "runtimes": [
          {
            "name": "apple_container",
            "captures": [
              "*"
            ],
            "config": {
              "container": "${MIRAGE_INTEG_APPLE_CONTAINER}",
              "env": {
                "BOX_MARKER": "from-config"
              }
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "echo $BOX_MARKER",
          "expect": {
            "exit": 0,
            "stdout": "from-config\n"
          }
        }
      ]
    },
    {
      "id": "own_guest_kernel",
      "world": {
        "runtimes": [
          {
            "name": "apple_container",
            "captures": [
              "*"
            ],
            "config": {
              "container": "${MIRAGE_INTEG_APPLE_CONTAINER}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "uname -s",
          "expect": {
            "exit": 0,
            "stdout": "Linux\n"
          }
        }
      ]
    },
    {
      "id": "line_timeout",
      "world": {
        "runtimes": [
          {
            "name": "apple_container",
            "captures": [
              "*"
            ],
            "config": {
              "container": "${MIRAGE_INTEG_APPLE_CONTAINER}"
            }
          },
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "limits": {
              "sleep": {
                "timeout_seconds": 1
              }
            }
          }
        }
      },
      "steps": [
        {
          "command": "sleep 5",
          "expect": {
            "exit": 124
          }
        }
      ]
    },
    {
      "id": "captured_only",
      "world": {
        "runtimes": [
          {
            "name": "apple_container",
            "captures": [
              "uname"
            ],
            "config": {
              "container": "${MIRAGE_INTEG_APPLE_CONTAINER}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "uname",
          "expect": {
            "exit": 0,
            "stdout": "Linux\n"
          }
        },
        {
          "command": "echo local-vfs",
          "expect": {
            "exit": 0,
            "stdout": "local-vfs\n"
          }
        }
      ]
    },
    {
      "id": "session_env_replaces_image_env",
      "world": {
        "runtimes": [
          {
            "name": "apple_container",
            "captures": [
              "printenv"
            ],
            "config": {
              "container": "${MIRAGE_INTEG_APPLE_CONTAINER}"
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "export PATH=/usr/bin:/bin",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "printenv PATH",
          "expect": {
            "exit": 0,
            "stdout": "/usr/bin:/bin\n"
          }
        }
      ]
    },
    {
      "id": "unserved_cwd_fails_loud",
      "world": {
        "runtimes": [
          {
            "name": "apple_container",
            "captures": [
              "uname"
            ],
            "config": {
              "container": "${MIRAGE_INTEG_APPLE_CONTAINER}"
            }
          },
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "cd /ram",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "uname",
          "expect": {
            "exit": 2,
            "stdout": "",
            "stderr_contains": "can't cd to /ram"
          }
        }
      ]
    },
    {
      "id": "unlisted_session_falls_back",
      "world": {
        "runtimes": [
          {
            "name": "apple_container",
            "captures": [
              "*"
            ],
            "config": {
              "container": "${MIRAGE_INTEG_APPLE_CONTAINER}",
              "containers": {
                "some_agent": "no-such-container"
              }
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "uname -s",
          "expect": {
            "exit": 0,
            "stdout": "Linux\n"
          }
        }
      ]
    },
    {
      "id": "unlisted_session_without_fallback_fails_loud",
      "world": {
        "runtimes": [
          {
            "name": "apple_container",
            "captures": [
              "*"
            ],
            "config": {
              "containers": {
                "some_agent": "${MIRAGE_INTEG_APPLE_CONTAINER}"
              }
            }
          },
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "uname -s",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr_contains": "apple_container has no container for session"
          }
        }
      ]
    }
  ]
}
