{
  "suite": "local",
  "cases": [
    {
      "id": "sys_argv",
      "world": {
        "runtimes": [
          "local"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import sys; print(sys.argv[1:])\" alpha beta",
          "expect": {
            "exit": 0,
            "stdout": "['alpha', 'beta']\n"
          }
        }
      ]
    },
    {
      "id": "host_script_is_named_after_its_workspace_path",
      "world": {
        "runtimes": [
          "local"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "f.py": "import sys\nprint(sys.argv[0], __file__)\n",
              "err.py": "x = 1\nprint(x / 0)\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 /ram/f.py",
          "expect": {
            "exit": 0,
            "stdout": "/ram/f.py /ram/f.py\n",
            "stderr": ""
          }
        },
        {
          "command": "cd /ram && python3 ./f.py",
          "expect": {
            "exit": 0,
            "stdout": "./f.py /ram/./f.py\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 /ram/err.py",
          "expect": {
            "exit": 1,
            "stderr_contains": "  File \"/ram/err.py\", line 2, in <module>\n"
          }
        },
        {
          "command": "echo 'print(__file__)' | python3 -",
          "expect": {
            "exit": 0,
            "stdout": "<stdin>\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "init_switches_reach_the_interpreter",
      "world": {
        "runtimes": [
          "local"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -O -c 'assert False; print(1)'",
          "expect": {
            "exit": 0,
            "stdout": "1\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -P -c 'import sys; print(\"\" in sys.path)'",
          "expect": {
            "exit": 0,
            "stdout": "False\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -B -W ignore -c 'import sys; print(sys.dont_write_bytecode, sys.warnoptions)'",
          "expect": {
            "exit": 0,
            "stdout": "True ['ignore']\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "closed_output_and_reuse",
      "world": {
        "runtimes": [
          "local",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import sys; print('out'); sys.stderr.write('err'); sys.stdout.close(); sys.stderr.close(); assert sys.stdout.closed and sys.stderr.closed\"",
          "expect": {
            "exit": 0,
            "stdout": "out\n",
            "stderr": "err"
          }
        },
        {
          "command": "python3 -c \"import sys; print('next'); sys.stderr.write('next err')\"",
          "expect": {
            "exit": 0,
            "stdout": "next\n",
            "stderr": "next err"
          }
        },
        {
          "command": "python3 -c \"import sys; sys.stdout.buffer.write(b'binary'); sys.stdout.buffer.close()\"",
          "expect": {
            "exit": 0,
            "stdout": "binary",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"import sys; print('before exit'); sys.stdout.close(); sys.stderr.close(); sys.exit(7)\"",
          "expect": {
            "exit": 7,
            "stdout": "before exit\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"print('after exit')\"",
          "expect": {
            "exit": 0,
            "stdout": "after exit\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "stdin_operand_path_policy",
      "note": "Stdin executes under a path deny in the cwd and preserves program arguments and flags.",
      "world": {
        "runtimes": [
          "local",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "default": {
            "commands": {
              "deny": [
                {
                  "reason": "sealed",
                  "paths": [
                    "/ram/*"
                  ]
                }
              ]
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /ram",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python - -c arg",
          "stdin": "import sys; print(sys.argv[1:])\n",
          "expect": {
            "exit": 0,
            "stdout": "['-c', 'arg']\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -u -- - -c arg",
          "stdin": "import sys; print(sys.argv[1:])\n",
          "expect": {
            "exit": 0,
            "stdout": "['-c', 'arg']\n",
            "stderr": ""
          }
        }
      ]
    }
  ]
}
