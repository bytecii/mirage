    {
      "id": "output_survives_failure_and_reuse",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "js -e \"console.log('before failure'); throw new Error('original failure')\"",
          "expect": {
            "exit": 1,
            "stdout": "before failure\n",
            "stderr_contains": "original failure"
          }
        },
        {
          "command": "js -e \"console.log('next')\"",
          "expect": {
            "exit": 0,
            "stdout": "next\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "no_extended_attribute_calls",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "node -e \"console.log(['getxattr', 'listxattr', 'removexattr', 'setxattr'].filter((n) => n in os).length)\"",
          "expect": {
            "exit": 0,
            "stdout": "0\n"
          }
        }
      ]
    },
    {
      "id": "listing_survives_a_failing_record",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/api": {
            "vfs": "ram",
            "files": {
              "items/0.json": "{\"id\": 0}\n",
              "items/1.json": "{\"id\": 1}\n",
              "items/2.json": "{\"id\": 2}\n",
              "items/3.json": "{\"id\": 3}\n"
            },
            "failing": [
              "items/2.json"
            ]
          }
        }
      },
      "steps": [
        {
          "command": "node -e \"const [names, err] = os.readdir('/api/items')\nconsole.log(err, names.filter((n) => n.endsWith('.json')).sort().join(','))\nconst [good] = os.stat('/api/items/1.json')\nconst [bad, badErr] = os.stat('/api/items/2.json')\nconsole.log(good.size, bad, badErr === 0 ? 'served' : 'failed', std.open('/api/items/2.json', 'r'))\"",
          "expect": {
            "exit": 0,
            "stdout": "0 0.json,1.json,2.json,3.json\n10 null failed null\n"
          }
        }
      ]
    },
    {
      "id": "shell_cwd_and_relative_ops",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "item": "hello\n",
              "sub/child": "child\n",
              "entry.mjs": "#!/usr/bin/env node\nconsole.log(os.getcwd()[0])\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /data",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "js -e \"console.log(os.getcwd()[0]); const f=std.open('./item','r'); console.log(f.readAsString().trim()); f.close()\"",
          "expect": {
            "exit": 0,
            "stdout": "/data\nhello\n"
          }
        },
        {
          "command": "js -e \"console.log(os.chdir('sub')); console.log(os.getcwd()[0]); console.log(os.stat('child')[1]); const f=std.open('../out','w'); f.puts('written'); f.close(); console.log(os.rename('../out','renamed')); console.log(os.readdir('.')[0].sort().join(',')); console.log(os.remove('renamed')); console.log(os.mkdir('empty')); console.log(os.remove('empty'))\"",
          "expect": {
            "exit": 0,
            "stdout": "0\n/data/sub\n0\n0\nchild,renamed\n0\n0\n0\n"
          }
        },
        {
          "command": "js -e \"console.log(os.chdir('missing')); console.log(os.getcwd()[0]); console.log(os.chdir('item')); console.log(os.getcwd()[0])\"",
          "expect": {
            "exit": 0,
            "stdout": "-44\n/data\n-54\n/data\n"
          }
        },
        {
          "command": "PWD=/wrong js -e \"console.log(os.getcwd()[0]); os.chdir('sub'); throw new Error('expected')\"",
          "expect": {
            "exit": 1,
            "stdout": "/data\n",
            "stderr_contains": "expected"
          }
        },
        {
          "command": "js -e \"console.log(os.getcwd()[0])\"; pwd",
          "expect": {
            "exit": 0,
            "stdout": "/data\n/data\n"
          }
        },
        {
          "command": "js -e \"'use strict'; try { missingName = 1; } catch(e) { console.log(e.name) }\"",
          "expect": {
            "exit": 0,
            "stdout": "ReferenceError\n"
          }
        },
        {
          "command": "js -m -e \"console.log(os.getcwd()[0]); console.log(std.open('item','r').readAsString().trim())\"",
          "expect": {
            "exit": 0,
            "stdout": "/data\nhello\n"
          }
        },
        {
          "command": "node entry.mjs",
          "expect": {
            "exit": 0,
            "stdout": "/data\n"
          }
        },
        {
          "command": "js -e \"const f=std.open('anchored','w'); os.chdir('sub'); f.puts('kept'); f.close()\"; cat /data/anchored",
          "expect": {
            "exit": 0,
            "stdout": "kept"
          }
        }
      ]
    },
    {
      "id": "open_follows_the_shared_rule",
      "backends": [
        "ram",
        "s3",
        "redis"
      ],
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "js -e \"console.log(std.open('/data/nope.txt', 'r') === null)\"",
          "expect": {
            "exit": 0,
            "stdout": "true\n",
            "ops_absent": [
              "create /data/nope.txt"
            ]
          }
        },
        {
          "command": "js -e \"console.log(std.open('/data/sub', 'w') === null)\"",
          "expect": {
            "exit": 0,
            "stdout": "true\n",
            "ops_absent": [
              "create /data/sub",
              "truncate /data/sub"
            ]
          }
        },
        {
          "command": "js -e \"console.log(std.open('/data/nope.txt', 'r+') === null)\"",
          "expect": {
            "exit": 0,
            "stdout": "true\n",
            "ops_absent": [
              "create /data/nope.txt"
            ]
          }
        },
        {
          "command": "js -e \"const f = std.open('/data/new.txt', 'w'); f.close()\"",
          "expect": {
            "exit": 0,
            "ops_contain": [
              "create /data/new.txt"
            ],
            "ops_absent": [
              "write /data/new.txt"
            ]
          }
        },
        {
          "command": "cat /data/new.txt",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "command": "js -e \"console.log(std.open('/data/seed.txt', 'wx') === null)\"",
          "expect": {
            "exit": 0,
            "stdout": "true\n",
            "ops_absent": [
              "create /data/seed.txt",
              "truncate /data/seed.txt",
              "write /data/seed.txt"
            ]
          }
        },
        {
          "command": "cat /data/seed.txt",
          "expect": {
            "exit": 0,
            "stdout": "seed\n"
          }
        },
        {
          "command": "js -e \"const f = std.open('/data/seed.txt', 'a'); f.puts('more\\n'); f.close()\"",
          "expect": {
            "exit": 0,
            "ops_absent": [
