{
  "suite": "quickjs",
  "requires": {
    "python": [
      "env:MIRAGE_QUICKJS_HOME"
    ],
    "typescript": []
  },
  "cases": [
    {
      "id": "eval",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "node -e \"console.log(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "pipe_to_grep",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "node -e \"console.log('alpha'); console.log('beta')\" | grep beta",
          "expect": {
            "exit": 0,
            "stdout": "beta\n"
          }
        }
      ]
    },
    {
      "id": "puts_print_raw",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "node -e \"std.out.puts('a'); std.out.puts('b'); print('c'); console.log({k: 1}, [1, 2])\"",
          "expect": {
            "exit": 0,
            "stdout": "abc\n[object Object] 1,2\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "printf",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "node -e \"const n = std.out.printf('[%s|%05d|%.2f|%x|%c|%%]', 'ab', 42, 3.14159, 255, 65); std.out.puts('\\n' + n)\"",
          "expect": {
            "exit": 0,
            "stdout": "[ab|00042|3.14|ff|A|%]\n22"
          }
        },
        {
          "command": "node -e \"std.out.printf('e[%e]g[%g]plus[%+d]hash[%#x]prec[%.3d]sp[% d]', 1234.5678, 1234.5678, 42, 255, 7, 9); std.out.puts('\\n')\"",
          "expect": {
            "exit": 0,
            "stdout": "e[1.234568e+03]g[1234.57]plus[+42]hash[0xff]prec[007]sp[ 9]\n"
          }
        },
        {
          "command": "node -e \"std.out.printf('star[%*d]prec[%.*f]', 6, 42, 2, 3.14159); std.out.puts('\\n')\"",
          "expect": {
            "exit": 0,
            "stdout": "star[    42]prec[3.14]\n"
          }
        },
        {
          "command": "node -e \"std.out.printf('%q', 1)\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "TypeError: invalid conversion specifier in format string"
          }
        }
      ]
    },
    {
      "id": "js_policy_reads_file",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "deny.txt": "node\n"
            }
          }
        },
        "route_policy": "const f = std.open('/ram/deny.txt', 'r'); const blocked = f !== null && f.readAsString().includes(ctx.command); if (f !== null) f.close(); blocked ? {deny: 'listed in /ram/deny.txt'} : null"
      },
      "steps": [
        {
          "command": "node -e \"console.log(1)\"",
          "expect": {
            "exit": 126,
            "stderr": "node: Permission denied\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "js_policy_deny",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": "ctx.command === 'node' ? {deny: 'no js here'} : null"
      },
      "steps": [
        {
          "command": "node -e \"console.log(1)\"",
          "expect": {
            "exit": 126,
            "stderr": "node: Permission denied\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "js_entry_script",
      "world": {
        "runtimes": [
          {
            "name": "quickjs",
            "script": "!ctx.line.includes('keep-out')"
          },
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "node -e \"console.log('served')\"",
          "expect": {
            "exit": 0,
            "stdout": "served\n"
          }
        },
        {
          "command": "node -e \"console.log('keep-out')\"",
          "expect": {
            "exit": 126,
            "stderr": "node: no runtime accepted this line\n"
          }
        }
      ]
    },
    {
      "id": "stdin_operand",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "default": {
            "commands": {
              "deny": [
                {
                  "reason": "sealed",
                  "paths": [
                    "/ram/*"
                  ]
                }
              ]
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /ram",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "echo 'console.log(scriptArgs.join(\",\"))' | node - a b",
          "expect": {
            "exit": 0,
            "stdout": "a,b\n"
          }
        },
        {
          "command": "echo 'console.log(\"stdin:\" + scriptArgs.join(\",\"))' | node - -e 'console.log(\"flag\")'",
          "expect": {
            "exit": 0,
            "stdout": "stdin:-e,console.log(\"flag\")\n"
          }
        },
        {
          "command": "echo 'console.log(scriptArgs.join(\",\"))' | node - -m",
          "expect": {
            "exit": 0,
            "stdout": "-m\n"
          }
        },
        {
          "command": "js -- - arg -e",
          "stdin": "console.log(scriptArgs.join(\",\"))",
          "expect": {
            "exit": 0,
            "stdout": "arg,-e\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "node_argv_is_typed_and_names_no_mount",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/w": {
            "vfs": "ram",
            "files": {
              "a.js": "console.log(JSON.stringify(scriptArgs))\n",
              "data/in.csv": "x\n"
            }
          },
          "/t": {
            "vfs": "ram",
            "files": {
              "q.txt": "from-t\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /w && node a.js data/in.csv ./data/in.csv",
          "expect": {
            "exit": 0,
            "stdout": "[\"data/in.csv\",\"./data/in.csv\"]\n",
            "stderr": ""
          }
        },
        {
          "command": "node /w/a.js /t/q.txt",
          "expect": {
            "exit": 0,
            "stdout": "[\"/t/q.txt\"]\n",
            "stderr": ""
          }
        },
        {
          "command": "node -e 'console.log(JSON.stringify(scriptArgs))' /t/q.txt /w/data/in.csv",
          "expect": {
            "exit": 0,
            "stdout": "[\"/t/q.txt\",\"/w/data/in.csv\"]\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "output_survives_failure_and_reuse",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "js -e \"console.log('before failure'); throw new Error('original failure')\"",
          "expect": {
            "exit": 1,
            "stdout": "before failure\n",
            "stderr_contains": "original failure"
          }
        },
        {
          "command": "js -e \"console.log('next')\"",
          "expect": {
            "exit": 0,
            "stdout": "next\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "version_names_quickjs_for_both_aliases",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "version.js": "console.log(scriptArgs[0])\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "for n in js node; do for f in --version -v; do $n $f 2>&1 | grep -cE '^JavaScript \\(quickjs [0-9]{4}-[0-9]{2}-[0-9]{2}\\)$'; done; done",
          "expect": {
            "exit": 0,
            "stdout": "1\n1\n1\n1\n",
            "stderr": ""
          }
        },
        {
          "command": "node -e \"console.log(scriptArgs[0])\" -- --version",
          "expect": {
            "exit": 0,
            "stdout": "--version\n",
            "stderr": ""
          }
        },
        {
          "command": "js /ram/version.js --version",
          "expect": {
            "exit": 0,
            "stdout": "--version\n",
            "stderr": ""
          }
        },
        {
          "command": "echo 'console.log(scriptArgs[0])' | node - --version",
          "expect": {
            "exit": 0,
            "stdout": "--version\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "stdin_and_module_mode",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "mod.mjs": "const k = await Promise.resolve(5);\nconsole.log(k * 2)\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "echo hello | js -e \"console.log(std.in.readAsString().trim().toUpperCase())\"",
          "expect": {
            "exit": 0,
            "stdout": "HELLO\n",
            "stderr": ""
          }
        },
        {
          "command": "js -m -e \"const x = await Promise.resolve(41); console.log(x + 1)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n",
            "stderr": ""
          }
        },
        {
          "command": "node /ram/mod.mjs",
          "expect": {
            "exit": 0,
            "stdout": "10\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "errors_and_the_sandbox",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "js -e \"this is not js\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "SyntaxError"
          }
        },
        {
          "command": "js -e \"console.log(typeof process, typeof require, typeof fetch)\"",
          "expect": {
            "exit": 0,
            "stdout": "undefined undefined undefined\n",
            "stderr": ""
          }
        },
        {
          "command": "js -e \"console.error('x')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "TypeError"
          }
        },
        {
          "command": "js",
          "expect": {
            "exit": 1,
            "stderr_contains": "js: no input"
          }
        },
        {
          "command": "js /missing-script",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "js: /missing-script: No such file\n"
          }
        },
        {
          "command": "node /missing-script",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "node: /missing-script: No such file\n"
          }
        }
      ]
    },
    {
      "id": "printf_more_conversions",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "js -e \"std.out.printf('E[%E]G[%G]o[%#o]neg[%05d]s[%.3s]c[%c]', 1234.5678, 0.00012, 8, -42, 'abcdef', 'zz')\"",
          "expect": {
            "exit": 0,
            "stdout": "E[1.234568E+03]G[0.00012]o[010]neg[-0042]s[abc]c[z]",
            "stderr": ""
          }
        }
      ]
    }
  ]
}
