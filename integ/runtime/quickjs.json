{
  "suite": "quickjs",
  "requires": {
    "python": [
      "env:MIRAGE_QUICKJS_HOME"
    ],
    "typescript": []
  },
  "cases": [
    {
      "id": "eval",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "node -e \"console.log(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "pipe_to_grep",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "node -e \"console.log('alpha'); console.log('beta')\" | grep beta",
          "expect": {
            "exit": 0,
            "stdout": "beta\n"
          }
        }
      ]
    },
    {
      "id": "puts_print_raw",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "node -e \"std.out.puts('a'); std.out.puts('b'); print('c'); console.log({k: 1}, [1, 2])\"",
          "expect": {
            "exit": 0,
            "stdout": "abc\n[object Object] 1,2\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "printf",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "node -e \"const n = std.out.printf('[%s|%05d|%.2f|%x|%c|%%]', 'ab', 42, 3.14159, 255, 65); std.out.puts('\\n' + n)\"",
          "expect": {
            "exit": 0,
            "stdout": "[ab|00042|3.14|ff|A|%]\n22"
          }
        },
        {
          "command": "node -e \"std.out.printf('e[%e]g[%g]plus[%+d]hash[%#x]prec[%.3d]sp[% d]', 1234.5678, 1234.5678, 42, 255, 7, 9); std.out.puts('\\n')\"",
          "expect": {
            "exit": 0,
            "stdout": "e[1.234568e+03]g[1234.57]plus[+42]hash[0xff]prec[007]sp[ 9]\n"
          }
        },
        {
          "command": "node -e \"std.out.printf('star[%*d]prec[%.*f]', 6, 42, 2, 3.14159); std.out.puts('\\n')\"",
          "expect": {
            "exit": 0,
            "stdout": "star[    42]prec[3.14]\n"
          }
        },
        {
          "command": "node -e \"std.out.printf('%q', 1)\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "TypeError: invalid conversion specifier in format string"
          }
        }
      ]
    },
    {
      "id": "js_policy_reads_file",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "deny.txt": "node\n"
            }
          }
        },
        "route_policy": "const f = std.open('/ram/deny.txt', 'r'); const blocked = f !== null && f.readAsString().includes(ctx.command); if (f !== null) f.close(); blocked ? {deny: 'listed in /ram/deny.txt'} : null"
      },
      "steps": [
        {
          "command": "node -e \"console.log(1)\"",
          "expect": {
            "exit": 126,
            "stderr": "node: Permission denied\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "js_policy_deny",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "route_policy": "ctx.command === 'node' ? {deny: 'no js here'} : null"
      },
      "steps": [
        {
          "command": "node -e \"console.log(1)\"",
          "expect": {
            "exit": 126,
            "stderr": "node: Permission denied\n"
          }
        },
        {
          "command": "echo still-open",
          "expect": {
            "exit": 0,
            "stdout": "still-open\n"
          }
        }
      ]
    },
    {
      "id": "js_entry_script",
      "world": {
        "runtimes": [
          {
            "name": "quickjs",
            "script": "!ctx.line.includes('keep-out')"
          },
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "node -e \"console.log('served')\"",
          "expect": {
            "exit": 0,
            "stdout": "served\n"
          }
        },
        {
          "command": "node -e \"console.log('keep-out')\"",
          "expect": {
            "exit": 126,
            "stderr": "node: no runtime accepted this line\n"
          }
        }
      ]
    },
    {
      "id": "stdin_operand",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        },
        "profiles": {
          "default": {
            "commands": {
              "deny": [
                {
                  "reason": "sealed",
                  "paths": [
                    "/ram/*"
                  ]
                }
              ]
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /ram",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "echo 'console.log(scriptArgs.join(\",\"))' | node - a b",
          "expect": {
            "exit": 0,
            "stdout": "a,b\n"
          }
        },
        {
          "command": "echo 'console.log(\"stdin:\" + scriptArgs.join(\",\"))' | node - -e 'console.log(\"flag\")'",
          "expect": {
            "exit": 0,
            "stdout": "stdin:-e,console.log(\"flag\")\n"
          }
        },
        {
          "command": "echo 'console.log(scriptArgs.join(\",\"))' | node - -m",
          "expect": {
            "exit": 0,
            "stdout": "-m\n"
          }
        },
        {
          "command": "js -- - arg -e",
          "stdin": "console.log(scriptArgs.join(\",\"))",
          "expect": {
            "exit": 0,
            "stdout": "arg,-e\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "node_argv_is_typed_and_names_no_mount",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/w": {
            "vfs": "ram",
            "files": {
              "a.js": "console.log(JSON.stringify(scriptArgs))\n",
              "data/in.csv": "x\n"
            }
          },
          "/t": {
            "vfs": "ram",
            "files": {
              "q.txt": "from-t\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /w && node a.js data/in.csv ./data/in.csv",
          "expect": {
            "exit": 0,
            "stdout": "[\"data/in.csv\",\"./data/in.csv\"]\n",
            "stderr": ""
          }
        },
        {
          "command": "node /w/a.js /t/q.txt",
          "expect": {
            "exit": 0,
            "stdout": "[\"/t/q.txt\"]\n",
            "stderr": ""
          }
        },
        {
          "command": "node -e 'console.log(JSON.stringify(scriptArgs))' /t/q.txt /w/data/in.csv",
          "expect": {
            "exit": 0,
            "stdout": "[\"/t/q.txt\",\"/w/data/in.csv\"]\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "utimes_reaches_the_mount",
      "backends": [
        "ram",
        "s3",
        "redis"
      ],
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "t.txt": "hello\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "node -e \"console.log(os.utimes('/ram/t.txt', 100000, 200000), os.utimes('/ram/nope.txt', 1, 2))\"",
          "expect": {
            "exit": 0,
            "stdout": "0 -44\n"
          }
        },
        {
          "command": "stat -c %Y /ram/t.txt",
          "expect": {
            "exit": 0,
            "stdout": "200\n"
          }
        }
      ]
    },
    {
      "id": "on_demand_mount_access",
      "world": {
        "runtimes": [
          "quickjs",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "one.txt": "one",
              "unused.txt": "unused"
            }
          },
          "/data/nested": {
            "vfs": "ram",
            "files": {
              "inside.txt": "nested"
            }
          },
          "/large": {
            "vfs": "ram",
            "generated_files": 47000
          }
        },
        "policies": [
          {
            "name": "seal_reads",
            "suffix": "/large"
          }
        ]
      },
      "steps": [
        {
          "facade": {
            "method": "is_file",
            "path": "/large/file-46999.txt"
          },
          "expect": {
            "value": true
          }
        },
        {
          "command": "js -e 'print(42)'",
          "expect": {
            "exit": 0,
            "stdout": "42\n",
            "stderr": "",
            "ops_absent": [
              "read"
            ]
          }
        },
        {
          "command": "js -e 'const f = std.open('\"'\"'/data/one.txt'\"'\"', '\"'\"'r'\"'\"'); print(f.readAsString()); f.close()'",
          "expect": {
            "exit": 0,
            "stdout": "one\n",
            "stderr": "",
            "ops_contain": [
              "read /data/one.txt"
            ],
            "ops_absent": [
              "read /data/unused.txt",
              "read /large/file-0.txt",
              "read /large/file-46999.txt"
            ]
          }
        },
        {
          "facade": {
            "method": "append",
            "path": "/data/one.txt",
            "data": "-fresh"
          },
          "expect": {
            "ops_contain": [
              "append /data/one.txt"
            ]
          }
        },
        {
          "command": "js -e 'const f = std.open('\"'\"'/data/one.txt'\"'\"', '\"'\"'r'\"'\"'); print(f.readAsString()); f.close()'",
          "expect": {
            "exit": 0,
            "stdout": "one-fresh\n",
            "stderr": "",
            "ops_contain": [
              "read /data/one.txt"
            ],
            "ops_absent": [
              "read /data/unused.txt",
              "read /large/file-0.txt",
              "read /large/file-46999.txt"
            ]
          }
        },
        {
          "command": "js -e 'const f = std.open('\"'\"'/data/nested/inside.txt'\"'\"', '\"'\"'r'\"'\"'); print(f.readAsString()); f.close()'",
          "expect": {
            "exit": 0,
            "stdout": "nested\n",
            "stderr": "",
            "ops_contain": [
              "read /data/nested/inside.txt"
            ],
            "ops_absent": [
              "read /data/unused.txt",
              "read /large/file-0.txt",
              "read /large/file-46999.txt"
            ]
          }
        },
        {
          "command": "js -e 'const f = std.open('\"'\"'/data/one.txt'\"'\"', '\"'\"'a'\"'\"'); f.puts('\"'\"'!'\"'\"'); f.close()'",
          "expect": {
            "exit": 0,
            "stdout": "",
            "stderr": "",
            "ops_contain": [
              "append /data/one.txt"
            ],
            "ops_absent": [
              "read /data/unused.txt",
              "read /large/file-0.txt",
              "read /large/file-46999.txt"
            ]
          }
        },
        {
          "command": "js -e 'const f = std.open('\"'\"'/data/one.txt'\"'\"', '\"'\"'r'\"'\"'); print(f.readAsString()); f.close()'",
          "expect": {
            "exit": 0,
            "stdout": "one-fresh!\n",
            "stderr": "",
            "ops_contain": [
              "read /data/one.txt"
            ],
            "ops_absent": [
              "read /data/unused.txt",
              "read /large/file-0.txt",
              "read /large/file-46999.txt"
            ]
          }
        },
        {
          "facade": {
            "method": "list_files",
            "path": "/large"
          },
          "expect": {
            "errno": "EACCES"
          }
        }
      ]
    },
