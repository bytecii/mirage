{
  "suite": "workspace",
  "cases": [
    {
      "id": "captures_restrict_py",
      "hosts": [
        "python"
      ],
      "world": {
        "runtimes": [
          "monty",
          {
            "name": "workspace",
            "captures": [
              "echo",
              "cat"
            ]
          }
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "echo vfs-captured",
          "expect": {
            "exit": 0,
            "stdout": "vfs-captured\n"
          }
        },
        {
          "command": "ls /ram",
          "expect": {
            "exit": 126,
            "stderr": "ls: no runtime accepted this line\n"
          }
        },
        {
          "command": "python3 -c \"print(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "captures_restrict_js",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "quickjs",
          {
            "name": "workspace",
            "captures": [
              "echo",
              "cat"
            ]
          }
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "echo vfs-captured",
          "expect": {
            "exit": 0,
            "stdout": "vfs-captured\n"
          }
        },
        {
          "command": "ls /ram",
          "expect": {
            "exit": 126,
            "stderr": "ls: no runtime accepted this line\n"
          }
        },
        {
          "command": "node -e \"console.log(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "lockdown_script",
      "world": {
        "runtimes": [
          {
            "name": "workspace",
            "script": "'secret' not in ctx['line']"
          },
          {
            "name": "monty",
            "captures": []
          }
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "echo fine",
          "expect": {
            "exit": 0,
            "stdout": "fine\n"
          }
        },
        {
          "command": "cat /ram/secret.txt",
          "expect": {
            "exit": 126,
            "stderr_contains": "no runtime accepted this line"
          }
        }
      ]
    },
    {
      "id": "ls_lists_past_a_failing_record",
      "world": {
        "runtimes": [
          "workspace"
        ],
        "mounts": {
          "/api": {
            "vfs": "ram",
            "files": {
              "items/0.json": "{\"id\": 0}\n",
              "items/1.json": "{\"id\": 1}\n",
              "items/2.json": "{\"id\": 2}\n",
              "items/3.json": "{\"id\": 3}\n",
              "items/sub/4.json": "{\"id\": 4}\n"
            },
            "failing": [
              "items/2.json"
            ]
          }
        }
      },
      "steps": [
        {
          "command": "ls /api/items; echo \"rc=$?\"",
          "expect": {
            "exit": 0,
            "stdout": "0.json\n1.json\n2.json\n3.json\nsub\nrc=0\n",
            "stderr": ""
          }
        },
        {
          "command": "ls -l /api/items | grep -F 2.json",
          "expect": {
            "exit": 0,
            "stdout": "?????????? ? ? ?    ?            ? 2.json\n",
            "stderr": "ls: cannot access '/api/items/2.json': upstream 502 Bad Gateway\n"
          }
        },
        {
          "command": "ls -l /api/items > /dev/null; echo \"rc=$?\"",
          "expect": {
            "exit": 0,
            "stdout": "rc=1\n",
            "stderr": "ls: cannot access '/api/items/2.json': upstream 502 Bad Gateway\n"
          }
        },
        {
          "command": "ls -F /api/items; echo \"rc=$?\"",
          "expect": {
            "exit": 0,
            "stdout": "0.json\n1.json\n2.json\n3.json\nsub/\nrc=1\n",
            "stderr": "ls: cannot access '/api/items/2.json': upstream 502 Bad Gateway\n"
          }
        },
        {
          "command": "ls -R /api/items; echo \"rc=$?\"",
          "expect": {
            "exit": 0,
            "stdout": "/api/items:\n0.json\n1.json\n2.json\n3.json\nsub\n\n/api/items/sub:\n4.json\nrc=1\n",
            "stderr": "ls: cannot access '/api/items/2.json': upstream 502 Bad Gateway\n"
          }
        }
      ]
    },
    {
      "id": "find_walks_past_a_failing_record",
      "world": {
        "runtimes": [
          "workspace"
        ],
        "mounts": {
          "/api": {
            "vfs": "ram",
            "files": {
              "items/0.json": "{\"id\": 0}\n",
              "items/1.json": "{\"id\": 1}\n",
              "items/2.json": "{\"id\": 2}\n",
              "items/3.json": "{\"id\": 3}\n",
              "items/sub/4.json": "{\"id\": 4}\n"
            },
            "failing": [
              "items/2.json"
            ]
          }
        }
      },
      "steps": [
        {
          "command": "find /api/items -type f; echo \"rc=$?\"",
          "expect": {
            "exit": 0,
            "stdout": "/api/items/0.json\n/api/items/1.json\n/api/items/2.json\n/api/items/3.json\n/api/items/sub/4.json\nrc=1\n",
            "stderr": "find: '/api/items/2.json': upstream 502 Bad Gateway\n"
          }
        },
        {
          "command": "find /api/items -type f -size -2k; echo \"rc=$?\"",
          "expect": {
            "exit": 0,
            "stdout": "/api/items/0.json\n/api/items/1.json\n/api/items/3.json\n/api/items/sub/4.json\nrc=1\n",
            "stderr": "find: '/api/items/2.json': upstream 502 Bad Gateway\n"
          }
        }
      ]
    },
    {
      "id": "no_language_runtime_leaves_no_interpreter_on_path",
      "world": {
        "runtimes": [
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "which python3 node; echo \"exit=$?\"",
          "expect": {
            "exit": 0,
            "stdout": "exit=1\n",
            "stderr": ""
          }
        },
        {
          "command": "type -a python3 node; echo \"exit=$?\"",
          "expect": {
            "exit": 0,
            "stdout": "exit=1\n",
            "stderr": "type: python3: not found\ntype: node: not found\n"
          }
        },
        {
          "command": "ls /usr/bin | grep -E '^(python|python3|node|js)$'; command -v python3; echo \"exit=$?\"",
          "expect": {
            "exit": 0,
            "stdout": "exit=1\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -V; echo \"exit=$?\"",
          "expect": {
            "exit": 0,
            "stdout": "exit=127\n",
            "stderr": "python3: command not found\n"
          }
        }
      ]
    }
  ]
}
