{
  "suite": "monty",
  "cases": [
    {
      "id": "default_world_python3",
      "world": {},
      "steps": [
        {
          "command": "python3 -c \"print(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "python_alias",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python -c 'print(6 * 7)'",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "python3_file_names_its_runtime",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "cat /usr/bin/python3",
          "expect": {
            "exit": 0,
            "stdout": "#!/bin/sh\n# python3 runs on the workspace's monty runtime.\ncommand python3 \"$@\"\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "module_flag_refused_by_name",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -m nosuchmodule",
          "expect": {
            "exit": 1,
            "stderr": "python3: -m is not supported by the 'monty' runtime\n"
          }
        },
        {
          "command": "python -m json.tool",
          "expect": {
            "exit": 1,
            "stderr": "python: -m is not supported by the 'monty' runtime\n"
          }
        }
      ]
    },
    {
      "id": "argv_global",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"print(argv[1:])\" alpha beta",
          "expect": {
            "exit": 0,
            "stdout": "['alpha', 'beta']\n"
          }
        }
      ]
    },
    {
      "id": "script_argv",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "data.txt": "hello from ram\n",
              "analyze.py": "from pathlib import Path\nprint('ram:', Path('/ram/data.txt').read_text().strip())\nprint('argv sum:', int(argv[1]) + int(argv[2]))\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 /ram/analyze.py 40 2",
          "expect": {
            "exit": 0,
            "stdout": "ram: hello from ram\nargv sum: 42\n"
          }
        }
      ]
    },
    {
      "id": "program_argv_is_typed_and_names_no_mount",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/w": {
            "vfs": "ram",
            "files": {
              "s.py": "print(argv[1:])\n",
              "read.py": "from pathlib import Path\nprint(Path(argv[1]).read_text(), end='')\n",
              "f.py": "print(__file__)\n",
              "data/in.csv": "x\n"
            }
          },
          "/t": {
            "vfs": "ram",
            "files": {
              "q.txt": "from-t\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /w",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 s.py data/in.csv data/in ./data/in.csv /w/data/",
          "expect": {
            "exit": 0,
            "stdout": "['data/in.csv', 'data/in', './data/in.csv', '/w/data/']\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 s.py data/*.csv 'data/*.csv'",
          "expect": {
            "exit": 0,
            "stdout": "['data/in.csv', 'data/*.csv']\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 /w/s.py /t/q.txt /t/new.csv",
          "expect": {
            "exit": 0,
            "stdout": "['/t/q.txt', '/t/new.csv']\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c 'print(argv[1:])' /t/q.txt /w/data/in.csv",
          "expect": {
            "exit": 0,
            "stdout": "['/t/q.txt', '/w/data/in.csv']\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 s.py --input /t/q.txt --out=/t/o.csv",
          "expect": {
            "exit": 0,
            "stdout": "['--input', '/t/q.txt', '--out=/t/o.csv']\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 read.py /t/q.txt",
          "expect": {
            "exit": 0,
            "stdout": "from-t\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 f.py",
          "expect": {
            "exit": 0,
            "stdout": "/w/f.py\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "stdin_pipe",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "pipe.py": "print('came-through-pipe')\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cat /ram/pipe.py | python3",
          "expect": {
            "exit": 0,
            "stdout": "came-through-pipe\n"
          }
        }
      ]
    },
    {
      "id": "pipe_to_grep",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"print('alpha'); print('beta')\" | grep beta",
          "expect": {
            "exit": 0,
            "stdout": "beta\n"
          }
        }
      ]
    },
    {
      "id": "env",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "export GREETING=hello-runtime && python3 -c \"import os; print(os.getenv('GREETING'))\"",
          "expect": {
            "exit": 0,
            "stdout": "hello-runtime\n"
          }
        }
      ]
    },
    {
      "id": "limit_timeout",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "slow.py": "n = 0\nfor i in range(300000000):\n    n = n + 1\n"
            },
            "limits": {
              "python3": {
                "timeout_seconds": 1
              }
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 /ram/slow.py",
          "expect": {
            "exit": 124,
            "stderr_contains": "timed out after"
          }
        }
      ]
    },
    {
      "id": "output_survives_failure_and_reuse",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -c \"print('before failure'); raise ValueError('original failure')\"",
          "expect": {
            "exit": 1,
            "stdout": "before failure\n",
            "stderr_contains": "original failure"
          }
        },
        {
          "command": "python3 -c \"print('next')\"",
          "expect": {
            "exit": 0,
            "stdout": "next\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "cpython_surface_known_gaps_1077",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "in.json": "{\"a\":1}"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c 'print(len([1,2]), sum([1,2]), sorted([3,1,2]))'",
          "expect": {
            "exit": 0,
            "stdout": "2 3 [1, 2, 3]\n"
          }
        },
        {
          "command": "python3 -c 'import json; print([n for n in ('\"'\"'load'\"'\"','\"'\"'loads'\"'\"','\"'\"'dump'\"'\"','\"'\"'dumps'\"'\"') if hasattr(json,n)])'",
          "expect": {
            "exit": 0,
            "stdout": "['loads', 'dumps']\n"
          }
        },
        {
          "command": "python3 -c 'print(dir(list))'",
          "expect": {
            "exit": 1,
            "stderr_contains": "NameError: name 'dir' is not defined"
          }
        },
        {
          "command": "python3 -c 'import json; print(dir(json))'",
          "expect": {
            "exit": 1,
            "stderr_contains": "NameError: name 'dir' is not defined"
          }
        },
        {
          "command": "python3 -c 'import json; print(json.load(open('\"'\"'/data/in.json'\"'\"')))'",
          "expect": {
            "exit": 1,
            "stderr_contains": "module 'json' has no attribute 'load'"
          }
        },
        {
          "command": "python3 -c 'import json; json.dump({'\"'\"'a'\"'\"': 1}, open('\"'\"'/data/out.json'\"'\"', '\"'\"'w'\"'\"'))'",
          "expect": {
            "exit": 1,
            "stderr_contains": "module 'json' has no attribute 'dump'"
          }
        },
        {
          "command": "python3 -c 'import json; print(json.loads(open('\"'\"'/data/in.json'\"'\"').read())); f = open('\"'\"'/data/out.json'\"'\"', '\"'\"'w'\"'\"'); f.write(json.dumps({'\"'\"'a'\"'\"': 2})); f.close()'",
          "expect": {
            "exit": 0,
            "stdout": "{'a': 1}\n"
          }
        },
        {
          "command": "cat /data/out.json",
          "expect": {
            "exit": 0,
            "stdout": "{\"a\": 2}"
          }
        }
      ]
    },
    {
      "id": "monty_023_python_surface",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -c 'from itertools import accumulate, batched, zip_longest; print('\"'\"'total={:04d}'\"'\"'.format(6)); print(list(accumulate([1,2,3]))); print(list(batched([1,2,3], 2))); print(list(zip_longest([1,2], [3], fillvalue=0)))'",
          "expect": {
            "exit": 0,
            "stdout": "total=0006\n[1, 3, 6]\n[(1, 2), (3,)]\n[(1, 3), (2, 0)]\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "cwd_relative_write_obeys_policy",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "in.txt": "hello"
            }
          }
        },
        "policies": [
          {
            "name": "lock_writes",
            "prefix": "/data/blocked"
          }
        ]
      },
      "steps": [
        {
          "command": "cd /data && python3 -c \"print(open('in.txt').read())\"",
          "expect": {
            "exit": 0,
            "stdout": "hello\n"
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; Path('blocked').write_text('changed')\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "PermissionError"
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; print(Path('blocked').exists())\"",
          "expect": {
            "exit": 0,
            "stdout": "False\n"
          }
        }
      ]
    },
    {
      "id": "script_operand_obeys_policy",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "secret.py": "print('secret')\n",
              "s.py": "print(argv[1:])\n"
            }
          }
        },
        "profiles": {
          "default": {
            "commands": {
              "deny": [
                {
                  "reason": "protected",
                  "commands": {
                    "python3": [
                      "/ram/secret.py"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /ram",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 secret.py",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python3: secret.py: protected\n"
          }
        },
        {
          "command": "python3 -u -- secret.py",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python3: secret.py: protected\n"
          }
        },
        {
          "command": "python3 s.py secret.py",
          "expect": {
            "exit": 0,
            "stdout": "['secret.py']\n"
          }
        },
        {
          "command": "echo 'print(argv[1:])' | python3 - secret.py",
          "expect": {
            "exit": 0,
            "stdout": "['secret.py']\n"
          }
        }
      ]
    },
    {
      "id": "os_urandom",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "item": "hello"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import os; print([(type(os.urandom(n)).__name__, len(os.urandom(n))) for n in [0, 8, 65537, 1048576]])\"",
          "expect": {
            "exit": 0,
            "stdout": "[('bytes', 0), ('bytes', 8), ('bytes', 65537), ('bytes', 1048576)]\n"
          }
        },
        {
          "command": "python3 -c \"import os; os.urandom(1048577)\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "MemoryError: os.urandom() size exceeds max_urandom_bytes (1048576)"
          }
        },
        {
          "command": "python3 -c \"import os; os.urandom(-1)\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "ValueError"
          }
        },
        {
          "command": "python3 -c \"import os; os.urandom(1.5)\"",
          "expect": {
            "exit": 1,
            "stderr_contains": "TypeError"
          }
        }
      ]
    },
    {
      "id": "option_refusals_follow_cpython",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -zz -c 'print(1)'",
          "expect": {
            "exit": 2,
            "stdout": "",
            "stderr": "Unknown option: -z\nusage: python3 [option] ... [-c cmd | -m mod | file | -] [arg] ...\nTry `python -h' for more information.\n"
          }
        },
        {
          "command": "python3 -c",
          "expect": {
            "exit": 2,
            "stdout": "",
            "stderr": "Argument expected for the -c option\nusage: python3 [option] ... [-c cmd | -m mod | file | -] [arg] ...\nTry `python -h' for more information.\n"
          }
        }
      ]
    },
    {
      "id": "version_names_the_monty_guest",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "version.py": "print(argv[-1])\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "for n in python python3; do for f in --version -V -VV; do $n $f; done; done",
          "expect": {
            "exit": 0,
            "stdout": "Python 3.14.0 (monty)\nPython 3.14.0 (monty)\nPython 3.14.0 (monty)\nPython 3.14.0 (monty)\nPython 3.14.0 (monty)\nPython 3.14.0 (monty)\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c 'print(argv[-1])' --version",
          "expect": {
            "exit": 0,
            "stdout": "--version\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 /ram/version.py --version",
          "expect": {
            "exit": 0,
            "stdout": "--version\n",
            "stderr": ""
          }
        },
        {
          "command": "echo 'print(argv[-1])' | python3 - --version",
          "expect": {
            "exit": 0,
            "stdout": "--version\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "script_operand_flags_and_argv",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "n.py": "print(42)\n",
              "a0.py": "print(argv[0])\n",
              "a1.py": "print(argv[1])\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -u /ram/n.py",
          "expect": {
            "exit": 0,
            "stdout": "42\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 /ram/a0.py",
          "expect": {
            "exit": 0,
            "stdout": "/ram/a0.py\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 /ram/a1.py --not-my-flag",
          "expect": {
            "exit": 0,
            "stdout": "--not-my-flag\n",
            "stderr": ""
          }
        },
        {
          "command": "echo 'print(7)' | python3 -",
          "expect": {
            "exit": 0,
            "stdout": "7\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -u -q -c 'print(1)'",
          "expect": {
            "exit": 0,
            "stdout": "1\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -O -c 'print(1)'",
          "expect": {
            "exit": 0,
            "stdout": "1\n",
            "stderr": "python3: warning: -O is ignored by the 'monty' runtime\n"
          }
        }
      ]
    },
    {
      "id": "invoked_name_errors_and_help",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python /missing-script",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python: /missing-script: No such file\n"
          }
        },
        {
          "command": "python3 /missing-script",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python3: /missing-script: No such file\n"
          }
        },
        {
          "command": "python3 -h",
          "expect": {
            "exit": 0,
            "stdout_contains": "Usage: python3"
          }
        }
      ]
    },
    {
      "id": "shadowing_function_takes_the_words_as_typed",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3() { echo \"$@\"; }",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c payload -u x",
          "expect": {
            "exit": 0,
            "stdout": "-c payload -u x\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "script_rule_reads_the_operand_as_typed",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "secret.py": "print('secret')\n"
            }
          }
        },
        "profiles": {
          "default": {
            "commands": {
              "deny": [
                {
                  "reason": "protected",
                  "commands": {
                    "python3": [
                      "/ram/secret.py"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /ram",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 ./secret.py",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "python3: ./secret.py: protected\n"
          }
        },
        {
          "command": "python3 -c 'print(argv[1:])' secret.py",
          "expect": {
            "exit": 0,
            "stdout": "['secret.py']\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "unknown_long_option_follows_cpython",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 --nope",
          "expect": {
            "exit": 2,
            "stdout": "",
            "stderr": "Unknown option: --nope\nusage: python3 [option] ... [-c cmd | -m mod | file | -] [arg] ...\nTry `python -h' for more information.\n"
          }
        }
      ]
    }
  ]
}
