    {
      "id": "on_demand_mount_access",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ],
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "one.txt": "one",
              "unused.txt": "unused"
            }
          },
          "/data/nested": {
            "vfs": "ram",
            "files": {
              "inside.txt": "nested"
            }
          },
          "/large": {
            "vfs": "ram",
            "generated_files": 47000
          }
        },
        "policies": [
          {
            "name": "seal_reads",
            "suffix": "/large"
          }
        ]
      },
      "steps": [
        {
          "facade": {
            "method": "is_file",
            "path": "/large/file-46999.txt"
          },
          "expect": {
            "value": true
          }
        },
        {
          "command": "python3 -c 'print(42)'",
          "expect": {
            "exit": 0,
            "stdout": "42\n",
            "stderr": "",
            "ops_absent": [
              "read"
            ]
          }
        },
        {
          "command": "python3 -c 'from pathlib import Path; print(Path('\"'\"'/data/one.txt'\"'\"').read_text())'",
          "expect": {
            "exit": 0,
            "stdout": "one\n",
            "stderr": "",
            "ops_contain": [
              "read /data/one.txt"
            ],
            "ops_absent": [
              "read /data/unused.txt",
              "read /large/file-0.txt",
              "read /large/file-46999.txt"
            ]
          }
        },
        {
          "facade": {
            "method": "append",
            "path": "/data/one.txt",
            "data": "-fresh"
          },
          "expect": {
            "ops_contain": [
              "append /data/one.txt"
            ]
          }
        },
        {
          "command": "python3 -c 'from pathlib import Path; print(Path('\"'\"'/data/one.txt'\"'\"').read_text())'",
          "expect": {
            "exit": 0,
            "stdout": "one-fresh\n",
            "stderr": "",
            "ops_contain": [
              "read /data/one.txt"
            ],
            "ops_absent": [
              "read /data/unused.txt",
              "read /large/file-0.txt",
              "read /large/file-46999.txt"
            ]
          }
        },
        {
          "command": "python3 -c 'from pathlib import Path; print(Path('\"'\"'/data/nested/inside.txt'\"'\"').read_text())'",
          "expect": {
            "exit": 0,
            "stdout": "nested\n",
            "stderr": "",
            "ops_contain": [
              "read /data/nested/inside.txt"
            ],
            "ops_absent": [
              "read /data/unused.txt",
              "read /large/file-0.txt",
              "read /large/file-46999.txt"
            ]
          }
        },
        {
          "command": "python3 -c 'f = open('\"'\"'/data/one.txt'\"'\"', '\"'\"'a'\"'\"'); f.write('\"'\"'!'\"'\"'); f.close()'",
          "expect": {
            "exit": 0,
            "stdout": "",
            "stderr": "",
            "ops_contain": [
              "append /data/one.txt"
            ],
            "ops_absent": [
              "read /data/unused.txt",
              "read /large/file-0.txt",
              "read /large/file-46999.txt"
            ]
          }
        },
        {
          "command": "python3 -c 'from pathlib import Path; print(Path('\"'\"'/data/one.txt'\"'\"').read_text())'",
          "expect": {
            "exit": 0,
            "stdout": "one-fresh!\n",
            "stderr": "",
            "ops_contain": [
              "read /data/one.txt"
            ],
            "ops_absent": [
              "read /data/unused.txt",
              "read /large/file-0.txt",
              "read /large/file-46999.txt"
            ]
          }
        },
        {
          "facade": {
            "method": "list_files",
            "path": "/large"
          },
          "expect": {
            "errno": "EACCES"
          }
        }
      ]
    },
