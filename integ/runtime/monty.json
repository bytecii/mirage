    {
      "id": "default_world_python3",
      "world": {},
      "steps": [
        {
          "command": "python3 -c \"print(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "python_alias",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python -c 'print(6 * 7)'",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "python3_file_names_its_runtime",
      "world": {
        "runtimes": [
          "monty",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "cat /usr/bin/python3",
          "expect": {
            "exit": 0,
            "stdout": "#!/bin/sh\n# python3 runs on the workspace's monty runtime.\ncommand python3 \"$@\"\n",
            "stderr": ""
          }
        }
      ]
    },
