{
  "suite": "pyodide",
  "cases": [
    {
      "id": "eval",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(6 * 7)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n"
          }
        }
      ]
    },
    {
      "id": "no_mount_preload",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ],
        "mounts": {
          "/cold": {
            "vfs": "ram",
            "files": {
              "one.txt": "one",
              "unused.txt": "unused"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"print(42)\"",
          "expect": {
            "exit": 0,
            "stdout": "42\n",
            "stderr": "",
            "ops_absent": [
              "read"
            ]
          }
        },
        {
          "command": "python3 -c \"print(open('/cold/one.txt').read())\"",
          "expect": {
            "exit": 0,
            "stdout": "one\n",
            "stderr": "",
            "ops_absent": [
              "read /cold/unused.txt"
            ],
            "ops_contain": [
              "read /cold/one.txt"
            ]
          }
        }
      ]
    },
    {
      "id": "root_mount_cwd_fallback",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ],
        "mounts": {
          "/": {
            "vfs": "ram",
            "files": {
              "work/program.py": "print('root script')\n"
            }
          },
          "/data": {
            "vfs": "ram",
            "files": {
              "sub/value.txt": "nested\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /work",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c 'print(1)'",
          "expect": {
            "exit": 0,
            "stdout": "1\n"
          }
        },
        {
          "command": "python3 program.py",
          "expect": {
            "exit": 0,
            "stdout": "root script\n"
          }
        },
        {
          "command": "pwd",
          "expect": {
            "exit": 0,
            "stdout": "/work\n"
          }
        },
        {
          "command": "cd /data/sub",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 -c \"from pathlib import Path; print(Path.cwd()); print(Path('value.txt').read_text(), end='')\"",
          "expect": {
            "exit": 0,
            "stdout": "/data/sub\nnested\n"
          }
        }
      ]
    },
    {
      "id": "closed_output_and_reuse",
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import sys; print('out'); sys.stderr.write('err'); sys.stdout.close(); sys.stderr.close(); assert sys.stdout.closed and sys.stderr.closed\"",
          "expect": {
            "exit": 0,
            "stdout": "out\n",
            "stderr": "err"
          }
        },
        {
          "command": "python3 -c \"import sys; print('next'); sys.stderr.write('next err')\"",
          "expect": {
            "exit": 0,
            "stdout": "next\n",
            "stderr": "next err"
          }
        },
        {
          "command": "python3 -c \"import sys; sys.stdout.buffer.write(b'binary'); sys.stdout.detach().close()\"",
          "expect": {
            "exit": 0,
            "stdout": "binary",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"import sys; print('before exit'); sys.stdout.close(); sys.stderr.close(); sys.exit(7)\"",
          "expect": {
            "exit": 7,
            "stdout": "before exit\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"print('after exit')\"",
          "expect": {
            "exit": 0,
            "stdout": "after exit\n",
            "stderr": ""
          }
        }
      ],
      "hosts": [
        "typescript"
      ]
    },
    {
      "id": "json_tool_closes_output",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram",
            "files": {
              "input.json": "{\"value\":1}"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -m json.tool /ram/input.json",
          "expect": {
            "exit": 0,
            "stdout": "{\n    \"value\": 1\n}\n",
            "stderr": ""
          }
        },
        {
          "command": "cat /ram/input.json | python3 -m json.tool",
          "expect": {
            "exit": 0,
            "stdout": "{\n    \"value\": 1\n}\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -m json.tool /ram/input.json > /ram/formatted.json",
          "expect": {
            "exit": 0,
            "stdout": "",
            "stderr": ""
          }
        },
        {
          "command": "cat /ram/formatted.json",
          "expect": {
            "exit": 0,
            "stdout": "{\n    \"value\": 1\n}\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"import sys; sys.stdin.close(); print('still works')\"",
          "expect": {
            "exit": 0,
            "stdout": "still works\n",
            "stderr": ""
          }
        },
        {
          "command": "echo reused | python3 -c \"import sys; print(sys.stdin.read(), end='')\"",
          "expect": {
            "exit": 0,
            "stdout": "reused\n",
            "stderr": ""
          }
        }
      ]
    },
    {
      "id": "command_environment_isolation",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "MIRAGE_ENV_LEAK_PROBE=guest python3 -c \"import os; print(os.environ['MIRAGE_ENV_LEAK_PROBE'])\"",
          "expect": {
            "exit": 0,
            "stdout": "guest\n"
          }
        },
        {
          "command": "python3 -c \"import os; print(os.environ.get('MIRAGE_ENV_LEAK_PROBE', '<unset>'))\"",
          "expect": {
            "exit": 0,
            "stdout": "<unset>\n"
          }
        }
      ]
    },
    {
      "id": "memory_growth_output",
      "sdk_only": "Holds 2.1 GB in one Pyodide heap for six steps to put output above the 2 GiB wasm32 boundary, an engine path the in-process pass already covers. Through the CLI that heap sits in a daemon sharing the runner with the other host's daemon, the service containers and the docker suite, where the case failed intermittently and nowhere else.",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ],
        "mounts": {
          "/ram": {
            "vfs": "ram"
          }
        }
      },
      "steps": [
        {
          "command": "python3 -c \"import builtins, json; builtins._pressure = [bytearray(700 * 1024 * 1024) for _ in range(3)]; builtins._small = [str(i).encode() for i in range(100000)]; rows = json.loads(json.dumps([{'value': i, 'text': '\u4e16\u754c'} for i in range(20000)])); assert len(rows) == 20000\"",
          "expect": {
            "exit": 0,
            "stdout": "",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"print('hello world')\"",
          "expect": {
            "exit": 0,
            "stdout": "hello world\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"print('hello')\"",
          "expect": {
            "exit": 0,
            "stdout": "hello\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"import sys; print('hello world'); sys.stderr.write('stderr \u2014 caf\u00e9 \ud83c\udf0d\\n')\"",
          "expect": {
            "exit": 0,
            "stdout": "hello world\n",
            "stderr": "stderr \u2014 caf\u00e9 \ud83c\udf0d\n"
          }
        },
        {
          "command": "python3 -c \"import sys; print('\u4e16\u754c \ud83c\udf0d'); sys.stderr.write('caf\u00e9 \ud83c\udf0d\\n')\" > /ram/stdout.txt 2> /ram/stderr.txt",
          "expect": {
            "exit": 0,
            "stdout": "",
            "stderr": ""
          }
        },
        {
          "command": "cat /ram/stdout.txt; cat /ram/stderr.txt",
          "expect": {
            "exit": 0,
            "stdout": "\u4e16\u754c \ud83c\udf0d\ncaf\u00e9 \ud83c\udf0d\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"print('hello world')\"",
          "expect": {
            "exit": 0,
            "stdout": "hello world\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"import builtins; del builtins._pressure, builtins._small\"",
          "expect": {
            "exit": 0,
            "stdout": "",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"import sys; print('after cleanup'); sys.stderr.write('still readable\\n')\"",
          "expect": {
            "exit": 0,
            "stdout": "after cleanup\n",
            "stderr": "still readable\n"
          }
        }
      ]
    },
    {
      "id": "user_tracebacks",
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ]
      },
      "steps": [
        {
          "command": "python3 -c 'print(1'",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "  File \"<string>\", line 1\n    print(1\n         ^\nSyntaxError: '(' was never closed\n"
          }
        },
        {
          "command": "python3 -c 'x = 1/0'",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "Traceback (most recent call last):\n  File \"<string>\", line 1, in <module>\nZeroDivisionError: division by zero\n"
          }
        },
        {
          "command": "python3 -c 'def fail():\n    return 1/0\nfail()'",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "Traceback (most recent call last):\n  File \"<string>\", line 3, in <module>\n  File \"<string>\", line 2, in fail\nZeroDivisionError: division by zero\n"
          }
        },
        {
          "command": "python3 -c 'raise SyntaxError('\"'\"'user error'\"'\"')'",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "Traceback (most recent call last):\n  File \"<string>\", line 1, in <module>\nSyntaxError: user error\n"
          }
        },
        {
          "command": "python3 -c 'try:\n    1/0\nexcept ZeroDivisionError as error:\n    raise ValueError('\"'\"'outer'\"'\"') from error'",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "Traceback (most recent call last):\n  File \"<string>\", line 2, in <module>\nZeroDivisionError: division by zero\n\nThe above exception was the direct cause of the following exception:\n\nTraceback (most recent call last):\n  File \"<string>\", line 4, in <module>\nValueError: outer\n"
          }
        }
      ],
      "hosts": [
        "typescript"
      ]
    },
    {
      "id": "script_file_names_the_program",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ],
        "mounts": {
          "/w": {
            "vfs": "ram",
            "files": {
              "app/file.py": "print(__file__)\n",
              "app/err.py": "x = 1\nprint(x / 0)\n",
              "app/imp.py": "import sys\nprint(repr(sys.path[0]))\nimport helper\n",
              "app/helper.py": "print('helper imported')\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 /w/app/file.py",
          "expect": {
            "exit": 0,
            "stdout": "/w/app/file.py\n",
            "stderr": ""
          }
        },
        {
          "command": "cd /w",
          "expect": {
            "exit": 0
          }
        },
        {
          "command": "python3 ./app/file.py",
          "expect": {
            "exit": 0,
            "stdout": "/w/./app/file.py\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 app/err.py",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr": "Traceback (most recent call last):\n  File \"/w/app/err.py\", line 2, in <module>\n    print(x / 0)\n          ~~^~~\nZeroDivisionError: division by zero\n"
          }
        },
        {
          "command": "python3 -P app/imp.py",
          "expect": {
            "exit": 1,
            "stderr_contains": "ModuleNotFoundError: No module named 'helper'"
          }
        },
        {
          "command": "python3 app/imp.py",
          "expect": {
            "exit": 0,
            "stdout": "'/w/app'\nhelper imported\n",
            "stderr": ""
          }
        },
        {
          "command": "cat app/file.py | python3 -",
          "expect": {
            "exit": 0,
            "stdout": "<stdin>\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c 'print(__file__)'",
          "expect": {
            "exit": 1,
            "stderr_contains": "NameError: name '__file__' is not defined"
          }
        }
      ]
    },
    {
      "id": "invocation_flags_and_import_paths_are_scoped",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          {
            "name": "pyodide",
            "config": {
              "sys_path": [
                "/w/vendor"
              ]
            }
          },
          "workspace"
        ],
        "mounts": {
          "/w": {
            "vfs": "ram",
            "files": {
              "app/probe.py": "import sys\nprint(sys.flags.safe_path, repr(sys.path[0]))\nsys.modules.pop('flag_import_probe', None)\nimport flag_import_probe\nprint(flag_import_probe.value)\n",
              "app/flag_import_probe.py": "value = 'script module'\n",
              "vendor/flag_import_probe.py": "value = 'vendor module'\n",
              "app/fail.py": "import sys\nprint(sys.flags.safe_path)\nraise ValueError('flagged failure')\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cd /w",
          "expect": {
            "exit": 0,
            "stdout": "",
            "stderr": ""
          }
        },
        {
          "command": "python3 -P app/probe.py",
          "expect": {
            "exit": 0,
            "stdout": "True '/w/vendor'\nvendor module\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 app/probe.py",
          "expect": {
            "exit": 0,
            "stdout": "False '/w/app'\nscript module\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -P -c \"import sys; print(sys.flags.safe_path, repr(sys.path[0]))\"",
          "expect": {
            "exit": 0,
            "stdout": "True '/w/vendor'\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"import sys; print(sys.flags.safe_path, repr(sys.path[0]))\"",
          "expect": {
            "exit": 0,
            "stdout": "False ''\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -P - <<'PY'\nimport sys; print(sys.flags.safe_path, repr(sys.path[0]))\nPY",
          "expect": {
            "exit": 0,
            "stdout": "True '/w/vendor'\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 - <<'PY'\nimport sys; print(sys.flags.safe_path, repr(sys.path[0]))\nPY",
          "expect": {
            "exit": 0,
            "stdout": "False ''\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -P -OO -B -c \"import sys; print(sys.flags.safe_path, sys.flags.optimize, __debug__, sys.flags.dont_write_bytecode == sys.dont_write_bytecode)\"",
          "expect": {
            "exit": 0,
            "stdout": "True 2 False True\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -c \"import sys; print(sys.flags.safe_path, sys.flags.optimize, __debug__, sys.flags.dont_write_bytecode == sys.dont_write_bytecode)\"",
          "expect": {
            "exit": 0,
            "stdout": "False 0 True True\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -P app/fail.py",
          "expect": {
            "exit": 1,
            "stdout": "True\n",
            "stderr_contains": "ValueError: flagged failure"
          }
        },
        {
          "command": "python3 app/probe.py",
          "expect": {
            "exit": 0,
            "stdout": "False '/w/app'\nscript module\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -E -c \"import sys; print(sys.flags.ignore_environment)\"",
          "expect": {
            "exit": 0,
            "stdout": "0\n",
            "stderr": "python3: warning: -E is ignored by the 'pyodide' runtime\n"
          }
        }
      ]
    },
    {
      "id": "optimize_reaches_imported_modules",
      "hosts": [
        "typescript"
      ],
      "world": {
        "runtimes": [
          "pyodide",
          "workspace"
        ],
        "mounts": {
          "/w": {
            "vfs": "ram",
            "files": {
              "app/main.py": "import sys\nsys.modules.pop('optimize_helper', None)\nimport optimize_helper\nprint(sys.flags.optimize, __debug__, optimize_helper.debug)\n",
              "app/optimize_helper.py": "debug = __debug__\nassert False, 'helper assert ran'\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "python3 -O /w/app/main.py",
          "expect": {
            "exit": 0,
            "stdout": "1 False False\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 -OO /w/app/main.py",
          "expect": {
            "exit": 0,
            "stdout": "2 False False\n",
            "stderr": ""
          }
        },
        {
          "command": "python3 /w/app/main.py",
          "expect": {
            "exit": 1,
            "stdout": "",
            "stderr_contains": "AssertionError: helper assert ran"
          }
        }
      ]
    },
