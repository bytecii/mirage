{
  "suite": "open",
  "cases": [
    {
      "id": "open_follows_the_shared_rule",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "backends": [
        "ram",
        "s3",
        "redis"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "try:\n    open('/data/nope.txt', 'r').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/data/nope.txt', 'r')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileNotFoundError\n",
            "ops_absent": [
              "create /data/nope.txt"
            ]
          },
          "expect_on": {
            "quickjs": {
              "stdout": "refused\n"
            }
          }
        },
        {
          "program": {
            "python": "try:\n    open('/data/seed.txt', 'r').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/data/seed.txt', 'r')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "opened\n",
            "ops_absent": [
              "create /data/seed.txt",
              "truncate /data/seed.txt",
              "write /data/seed.txt"
            ]
          }
        },
        {
          "program": {
            "python": "try:\n    open('/data/sub', 'w').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/data/sub', 'w')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "IsADirectoryError\n",
            "ops_absent": [
              "create /data/sub",
              "truncate /data/sub"
            ]
          },
          "expect_on": {
            "quickjs": {
              "stdout": "refused\n"
            }
          }
        },
        {
          "program": {
            "python": "try:\n    open('/data/nope.txt', 'r+').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/data/nope.txt', 'r+')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileNotFoundError\n",
            "ops_absent": [
              "create /data/nope.txt"
            ]
          },
          "expect_on": {
            "quickjs": {
              "stdout": "refused\n"
            },
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "update modes ('+') are not yet supported"
            }
          }
        },
        {
          "program": {
            "python": "try:\n    open('/data/new.txt', 'w').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/data/new.txt', 'w')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "opened\n",
            "ops_contain": [
              "create /data/new.txt"
            ],
            "ops_absent": [
              "write /data/new.txt",
              "append /data/new.txt"
            ]
          },
          "expect_on": {
            "pyodide": {
              "ops_contain": [
                "write /data/new.txt"
              ],
              "ops_absent": []
            }
          }
        },
        {
          "command": "cat /data/new.txt",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "program": {
            "python": "try:\n    open('/data/seed.txt', 'x').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/data/seed.txt', 'wx')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileExistsError\n",
            "ops_absent": [
              "create /data/seed.txt",
              "truncate /data/seed.txt",
              "write /data/seed.txt"
            ]
          },
          "expect_on": {
            "quickjs": {
              "stdout": "refused\n"
            },
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "exclusive creation mode is not supported"
            }
          }
        },
        {
          "command": "cat /data/seed.txt",
          "expect": {
            "exit": 0,
            "stdout": "seed\n"
          }
        },
        {
          "program": {
            "python": "f = open('/data/seed.txt', 'a')\nf.write('more\\n')\nf.close()",
            "js": "const f = std.open('/data/seed.txt', 'a')\nf.puts('more\\n')\nf.close()"
          },
          "expect": {
            "exit": 0,
            "ops_absent": [
              "truncate /data/seed.txt"
            ]
          }
        },
        {
          "command": "cat /data/seed.txt",
          "expect": {
            "exit": 0,
            "stdout": "seed\nmore\n"
          }
        },
        {
          "program": {
            "python": "try:\n    open('/data/seed.txt', 'w').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/data/seed.txt', 'w')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "opened\n",
            "ops_contain": [
              "truncate /data/seed.txt"
            ],
            "ops_absent": [
              "create /data/seed.txt"
            ]
          },
          "expect_on": {
            "pyodide": {
              "ops_contain": [
                "write /data/seed.txt"
              ]
            }
          }
        },
        {
          "command": "cat /data/seed.txt",
          "expect": {
            "exit": 0,
            "stdout": ""
          }
        },
        {
          "program": {
            "python": "f = open('/data/fresh.txt', 'x')\nf.write('fresh')\nf.close()",
            "js": "const f = std.open('/data/fresh.txt', 'wx')\nf.puts('fresh')\nf.close()"
          },
          "expect": {
            "exit": 0,
            "ops_contain": [
              "create /data/fresh.txt"
            ]
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "ops_contain": [],
              "stderr_contains": "exclusive creation mode is not supported"
            },
            "pyodide": {
              "ops_contain": [
                "write /data/fresh.txt"
              ]
            }
          }
        },
        {
          "command": "cat /data/fresh.txt",
          "expect": {
            "exit": 0,
            "stdout": "fresh"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "No such file or directory"
            }
          }
        },
        {
          "program": {
            "python": "f = open('/data/log.txt', 'a')\nf.write('one\\n')\nf.close()",
            "js": "const f = std.open('/data/log.txt', 'a')\nf.puts('one\\n')\nf.close()"
          },
          "expect": {
            "exit": 0,
            "ops_contain": [
              "create /data/log.txt"
            ]
          },
          "expect_on": {
            "pyodide": {
              "ops_contain": [
                "write /data/log.txt"
              ]
            }
          }
        },
        {
          "program": {
            "python": "f = open('/data/log.txt', 'a')\nf.write('two\\n')\nf.close()",
            "js": "const f = std.open('/data/log.txt', 'a')\nf.puts('two\\n')\nf.close()"
          },
          "expect": {
            "exit": 0,
            "ops_contain": [
              "append /data/log.txt"
            ],
            "ops_absent": [
              "create /data/log.txt",
              "truncate /data/log.txt"
            ]
          },
          "expect_on": {
            "s3": {
              "ops_contain": [
                "write /data/log.txt"
              ]
            }
          }
        },
        {
          "command": "cat /data/log.txt",
          "expect": {
            "exit": 0,
            "stdout": "one\ntwo\n"
          }
        },
        {
          "command": "ln -s /data/gone /data/lnk",
          "expect": {
            "exit": 0
          }
        },
        {
          "program": {
            "python": "try:\n    open('/data/lnk', 'x').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/data/lnk', 'wx')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileExistsError\n",
            "ops_absent": [
              "create /data/lnk",
              "create /data/gone"
            ]
          },
          "expect_on": {
            "quickjs": {
              "stdout": "refused\n"
            },
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "exclusive creation mode is not supported"
            },
            "pyodide": {
              "stdout": "opened\n"
            }
          }
        },
        {
          "program": {
            "python": "import os\nf = open('/data/seed.txt', 'w')\nprint(os.fstat(f.fileno()).st_mtime > 0)"
          },
          "expect": {
            "exit": 0,
            "stdout": "True\n"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "",
              "stderr_contains": "'_io.TextIOWrapper' object has no attribute 'fileno'"
            }
          }
        }
      ]
    },
    {
      "id": "content_outside_the_view_is_refused",
      "note": "Pyodide is not on the shared view rule yet: a write outside every mount (/tmp/new.txt) lands in the interpreter's own MEMFS, where monty, quickjs and wasi refuse it.",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "a.txt": "a\n"
            }
          }
        }
      },
      "steps": [
        {
          "command": "cat /data/a.txt",
          "expect": {
            "exit": 0,
            "stdout": "a\n"
          }
        },
        {
          "command": "cat /.bash_history",
          "expect": {
            "exit": 0,
            "stdout_contains": "cat /data/a.txt"
          }
        },
        {
          "program": {
            "python": "try:\n    open('/.bash_history', 'r').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/.bash_history', 'r')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileNotFoundError\n",
            "ops_absent": [
              "read /.bash_history"
            ]
          },
          "expect_on": {
            "quickjs": {
              "stdout": "refused\n"
            }
          }
        },
        {
          "program": {
            "python": "try:\n    open('/tmp/new.txt', 'w').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/tmp/new.txt', 'w')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileNotFoundError\n",
            "ops_absent": [
              "create /tmp/new.txt"
            ]
          },
          "expect_on": {
            "quickjs": {
              "stdout": "refused\n"
            },
            "pyodide": {
              "stdout": "opened\n"
            }
          }
        },
        {
          "program": {
            "python": "from pathlib import Path\nprint(Path('/tmp/new.txt').exists())",
            "js": "console.log(os.stat('/tmp/new.txt')[1])"
          },
          "expect": {
            "exit": 0,
            "stdout": "False\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "44\n"
            },
            "pyodide": {
              "stdout": "True\n"
            }
          }
        },
        {
          "program": {
            "python": "try:\n    open('/etc/passwd', 'r').close()\n    print('opened')\nexcept OSError as e:\n    print(type(e).__name__)",
            "js": "const f = std.open('/etc/passwd', 'r')\nif (f !== null) f.close()\nconsole.log(f === null ? 'refused' : 'opened')"
          },
          "expect": {
            "exit": 0,
            "stdout": "FileNotFoundError\n"
          },
          "expect_on": {
            "quickjs": {
              "stdout": "refused\n"
            }
          }
        }
      ]
    },
    {
      "id": "refuses_a_malformed_mode",
      "note": "qjs-libc checks a mode word character by character, so the real engine (quickjs on the python host) opens 'rr'. The TypeScript shim parses modes with the shared parser, which also holds CPython's one-base rule and refuses it.",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "open('/data/seed.txt', 'rr')",
            "js": "std.open('/data/seed.txt', 'rr')"
          },
          "expect": {
            "exit": 1,
            "stderr_contains": "invalid mode: 'rr'"
          },
          "expect_on": {
            "monty": {
              "stderr_contains": "must have exactly one of create/read/write/append mode"
            },
            "quickjs": {
              "stderr_contains": "invalid file mode"
            },
            "quickjs@python": {
              "exit": 0,
              "stderr_contains": ""
            }
          }
        },
        {
          "program": {
            "python": "open('/data/seed.txt', 'rq')",
            "js": "std.open('/data/seed.txt', 'rq')"
          },
          "expect": {
            "exit": 1,
            "stderr_contains": "invalid mode: 'rq'"
          },
          "expect_on": {
            "monty": {
              "stderr_contains": "invalid mode: 'q'"
            },
            "quickjs": {
              "stderr_contains": "invalid file mode"
            }
          }
        }
      ]
    },
    {
      "id": "a_missing_file_is_a_typed_error",
      "runtimes": [
        "monty",
        "wasi",
        "pyodide",
        "quickjs"
      ],
      "world": {
        "mounts": {
          "/data": {
            "vfs": "ram",
            "files": {
              "seed.txt": "seed\n",
              "sub/inner.txt": "in\n"
            }
          }
        }
      },
      "steps": [
        {
          "program": {
            "python": "from pathlib import Path\ntry:\n    Path('/data/nope.txt').read_text()\nexcept FileNotFoundError as e:\n    print('caught', type(e).__name__)\n    print(e.strerror)\n    print(e.filename)"
          },
          "expect": {
            "exit": 0,
            "stdout": "caught FileNotFoundError\nNo such file or directory\n/data/nope.txt\n"
          },
          "expect_on": {
            "monty": {
              "exit": 1,
              "stdout": "caught FileNotFoundError\n",
              "stderr_contains": "'FileNotFoundError' object has no attribute 'strerror'"
            }
          }
        },
        {
          "program": {
            "js": "const err = {}\nconsole.log(std.open('/data/nope.txt', 'r', err), err.errno)"
          },
          "expect": {
            "exit": 0,
            "stdout": "null 44\n"
          },
          "expect_on": {
            "quickjs@typescript": {
              "stdout": "null undefined\n"
            }
          }
        }
      ]
    }
  ]
}
