{
  "cases": [
    {
      "id": "which_prints_the_programs_file",
      "seq": 915,
      "targets": [
        "ram"
      ],
      "command": "which cat",
      "expect": {
        "exit": 0,
        "stdout": "/usr/bin/cat\n",
        "stderr": ""
      }
    },
    {
      "id": "which_miss_is_silent",
      "seq": 916,
      "targets": [
        "ram"
      ],
      "command": "which nope-xyz",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "which_keyword_is_not_a_command",
      "seq": 917,
      "targets": [
        "ram"
      ],
      "command": "which if",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "which_all_found_exit_rule",
      "seq": 918,
      "targets": [
        "ram"
      ],
      "command": "which cat nope-xyz",
      "expect": {
        "exit": 1,
        "stdout": "/usr/bin/cat\n",
        "stderr": ""
      }
    },
    {
      "id": "which_no_operand_exits_1",
      "seq": 919,
      "targets": [
        "ram"
      ],
      "command": "which",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "which_s_reports_through_the_status",
      "seq": 920,
      "targets": [
        "ram"
      ],
      "command": "which -s cat",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "which_invalid_option",
      "seq": 921,
      "targets": [
        "ram"
      ],
      "command": "which -z cat",
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": "which: -z: invalid option\nwhich: usage: which [-as] name [name ...]\n"
      }
    },
    {
      "id": "which_prints_one_file_per_program",
      "seq": 991500,
      "targets": [
        "ram"
      ],
      "note": "debianutils which on debian:stable-slim prints the file PATH finds; every program mirage runs has one under /usr/bin.",
      "command": "which ls sort; echo \"rc=$?\"",
      "expect": {
        "exit": 0,
        "stdout": "/usr/bin/ls\n/usr/bin/sort\nrc=0\n",
        "stderr": ""
      }
    },
    {
      "id": "which_builtin_without_a_program_misses",
      "seq": 991501,
      "targets": [
        "ram"
      ],
      "note": "GNU: cd is bash's alone, no file on PATH, so which prints nothing and exits 1.",
      "command": "which cd; echo \"rc=$?\"",
      "expect": {
        "exit": 0,
        "stdout": "rc=1\n",
        "stderr": ""
      }
    },
    {
      "id": "which_a_searches_the_one_directory",
      "seq": 991502,
      "targets": [
        "ram"
      ],
      "command": "which -a ls",
      "expect": {
        "exit": 0,
        "stdout": "/usr/bin/ls\n",
        "stderr": ""
      }
    },
    {
      "id": "which_names_an_executable_file",
      "seq": 991503,
      "targets": [
        "ram"
      ],
      "command": "[ -x \"$(which ls)\" ] && echo executable || echo \"not a file\"",
      "expect": {
        "exit": 0,
        "stdout": "executable\n",
        "stderr": ""
      }
    },
    {
      "id": "which_file_reads_as_the_script_that_runs_it",
      "seq": 991504,
      "targets": [
        "ram"
      ],
      "command": "cat \"$(which ls)\"",
      "expect": {
        "exit": 0,
        "stdout": "#!/bin/sh\n# ls runs inside mirage; this file is where PATH finds it (see: man ls).\ncommand ls \"$@\"\n",
        "stderr": ""
      }
    },
    {
      "id": "which_file_runs_the_program_by_path",
      "seq": 991505,
      "targets": [
        "ram"
      ],
      "command": "/usr/bin/echo hi there",
      "expect": {
        "exit": 0,
        "stdout": "hi there\n",
        "stderr": ""
      }
    },
    {
      "id": "path_names_the_program_directory",
      "seq": 991506,
      "targets": [
        "ram"
      ],
      "command": "echo \"$PATH\"",
      "expect": {
        "exit": 0,
        "stdout": "/usr/bin\n",
        "stderr": ""
      }
    },
    {
      "id": "usr_bin_has_no_file_for_a_shell_only_builtin",
      "seq": 991507,
      "targets": [
        "ram"
      ],
      "command": "ls /usr/bin/cd; echo \"rc=$?\"",
      "expect": {
        "exit": 0,
        "stdout": "rc=2\n",
        "stderr": "ls: cannot access '/usr/bin/cd': No such file or directory\n"
      }
    }
  ]
}
