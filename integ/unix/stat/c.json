    {
      "id": "stat_mount_root_names_the_operand",
      "note": "A mount root's name comes from the operand, never from the backend serving it. A backend names its own root the way its store spells one: ram answers `/` and disk answers the host directory's basename, which put a real host path in the answer to a question asked about a virtual one. `%n` was always the operand (seq 94), so only the default render could carry that, and only the name field is asserted because size and mtime are legitimately per-backend.",
      "seq": 95,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "stat /data | cut -d' ' -f1",
      "expect": {
        "exit": 0,
        "stdout": "name=data\n",
        "stderr": ""
      }
    },
    {
      "id": "stat_y_never_prints_zero_millis",
      "seq": 96,
      "targets": [
        "s3",
        "s3-prefix",
        "gridfs",
        "gridfs-prefix",
        "ssh",
        "databricks",
        "databricks-prefix"
      ],
      "command": "stat -c '%y' /data/a.txt | grep -vc '\\.000Z'",
      "expect": {
        "exit": 0,
        "stdout": "1\n",
        "stderr": ""
      }
    }
  ]
