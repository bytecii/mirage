{
  "cases": [
    {
      "id": "zgrep_searches_a_plain_file_as_it_is",
      "seq": 917100,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "box"
      ],
      "command": "zgrep hello /data/a.txt",
      "expect": {
        "exit": 0,
        "stdout": "hello\n",
        "stderr": ""
      }
    },
    {
      "id": "zgrep_counts_across_plain_files",
