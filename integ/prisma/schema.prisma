// Backing store for the integ battery's shared API fakes. One Node server per
// service (integ/server/slack.ts, integ/server/trello.ts) serves that vendor's
// HTTP API out of this SQLite store, seeded from integ/fixtures/<service>/v1.json;
// the Python and TypeScript battery hosts both call it over HTTP, so responses
// are byte-identical across hosts by construction. Flat scalar FKs (no
// @relation) — the fakes query each table explicitly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("INTEG_DB_URL")
}

model Channel {
  id         String  @id
  name       String
  kind       String
  created    Int
  isArchived Boolean @default(false)
  isPrivate  Boolean @default(false)
  dmUserId   String?
}

model User {
  id       String  @id
  name     String
  realName String
  email    String
  isBot    Boolean @default(false)
  deleted  Boolean @default(false)
}

model Message {
  pk           Int     @id @default(autoincrement())
  channelId    String
  ts           String
  userId       String
  text         String
  type         String  @default("message")
  threadTs     String?
  reactionsJson String?
}

model SlackFile {
  id          String  @id
  channelId   String
  messageTs   String
  name        String
  title       String
  mimetype    String
  filetype    String
  size        Int
  timestamp   Int
  content     String
  contentPath String?
}

// Trello. The vendor API returns collections in a caller-visible order that
// the fixture fixes and writes append to, so every table that can be listed
// carries an explicit `seq` and is read back with orderBy seq. Membership
// tables (card members, card labels) are rows rather than JSON arrays so an
// idempotent add is a findFirst, matching what the real endpoints do.

model TrelloWorkspace {
  id          String @id
  displayName String
  name        String
  seq         Int
}

model TrelloBoard {
  id               String  @id
  workspaceId      String
  name             String
  closed           Boolean @default(false)
  url              String?
  dateLastActivity String?
  seq              Int
}

model TrelloMember {
  id       String @id
  username String
  fullName String
}

model TrelloBoardMember {
  pk       Int    @id @default(autoincrement())
  boardId  String
  memberId String
  seq      Int
}

model TrelloLabel {
  id      String  @id
  boardId String
  name    String
  color   String?
  seq     Int
}

model TrelloList {
  id      String  @id
  boardId String
  name    String
  closed  Boolean @default(false)
  pos     Int?
  seq     Int
}

model TrelloCard {
  id               String  @id
  boardId          String
  listId           String
  name             String
  desc             String  @default("")
  due              String?
  dueComplete      Boolean @default(false)
  closed           Boolean @default(false)
  dateLastActivity String?
  seq              Int
}

model TrelloCardMember {
  pk       Int    @id @default(autoincrement())
  cardId   String
  memberId String
  seq      Int
}

model TrelloCardLabel {
  pk      Int    @id @default(autoincrement())
  cardId  String
  labelId String
  seq     Int
}

model TrelloComment {
  id       String  @id
  cardId   String
  memberId String?
  text     String
  date     String?
  seq      Int
}
