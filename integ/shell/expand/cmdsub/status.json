    {
      "id": "cmdsub_keeps_exit_status_and_trims_newlines",
      "seq": 1010006,
      "targets": [
        "ram",
        "disk",
        "redis",
        "opfs",
        "s3",
        "databricks",
        "gridfs",
        "s3-prefix",
        "databricks-prefix",
        "gridfs-prefix",
        "hf",
        "hf-prefix",
        "dropbox",
        "dropbox-root",
        "onedrive",
        "sharepoint",
        "sharepoint-prefix",
        "ssh",
        "nextcloud",
        "gdrive",
        "gdrive-folder",
        "box"
      ],
      "command": "bash -c 'value=$(printf \"kept\\n\\n\"; exit 9); echo \"status:$? value:[$value]\"'",
      "expect": {
        "exit": 0,
        "stdout": "status:9 value:[kept]\n",
        "stderr": ""
      }
    },
