{
  "family": "shell-trap",
  "cases": [
    {
      "id": "shell_trap_script_eof",
      "seq": 511000,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "bash -c 'trap \"echo cleanup\" EXIT; echo body' ",
      "expect": {
        "exit": 0,
        "stdout": "body\ncleanup\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_explicit_exit_status",
      "seq": 511001,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap 'echo cleanup:$?; false' EXIT; echo body; exit 7; echo BAD",
      "expect": {
        "exit": 7,
        "stdout": "body\ncleanup:7\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_handler_exit_override",
      "seq": 511002,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap 'echo cleanup:$?; exit 9; echo BAD' EXIT; exit 7",
      "expect": {
        "exit": 9,
        "stdout": "cleanup:7\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_errexit",
      "seq": 511003,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "bash -c 'trap '\"'\"'echo cleanup:$?'\"'\"' EXIT; set -e; false; echo BAD'",
      "expect": {
        "exit": 1,
        "stdout": "cleanup:1\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_replace_reset_ignore",
      "seq": 511004,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap 'echo old' EXIT; trap 'echo new' 0; trap -p; trap - EXIT; trap -p; trap '' EXIT; trap -p; exit",
      "expect": {
        "exit": 0,
        "stdout": "trap -- 'echo new' EXIT\ntrap -- '' EXIT\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_numeric_reset",
      "seq": 511005,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap 'echo BAD' EXIT; trap 0; trap -p; exit",
      "expect": {
        "exit": 0,
        "stdout": "",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_listing_quotes",
      "seq": 511006,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap \"printf '%s' hello\" EXIT; trap -p EXIT 0; trap - EXIT",
      "expect": {
        "exit": 0,
        "stdout": "trap -- 'printf '\\''%s'\\'' hello' EXIT\ntrap -- 'printf '\\''%s'\\'' hello' EXIT\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_subshell_inheritance",
      "seq": 511007,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap 'echo parent' EXIT; (trap -p; echo sub); (trap 'echo child' EXIT; echo body); exit",
      "expect": {
        "exit": 0,
        "stdout": "trap -- 'echo parent' EXIT\nsub\nbody\nchild\nparent\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_nested_shell_reset",
      "seq": 511008,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap 'echo parent' EXIT; bash -c 'trap -p; trap \"echo child\" EXIT; echo body'; exit",
      "expect": {
        "exit": 0,
        "stdout": "body\nchild\nparent\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_command_substitution",
      "seq": 511009,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap 'echo parent' EXIT; X=parent; result=$(X=child; trap 'echo child:$X' EXIT; echo body); echo \"$result\"; echo \"$X\"; exit",
      "expect": {
        "exit": 0,
        "stdout": "body\nchild:child\nparent\nparent\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_backtick",
      "seq": 511010,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "result=`trap 'echo cleanup' EXIT; echo body`; echo \"$result\"; trap -p",
      "expect": {
        "exit": 0,
        "stdout": "body\ncleanup\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_substitution_exit",
      "seq": 511011,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap 'echo parent' EXIT; result=$(trap 'echo child:$?' EXIT; echo body; exit 4; echo BAD); echo \"$?:$result\"; exit",
      "expect": {
        "exit": 0,
        "stdout": "4:body\nchild:4\nparent\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_eval_exit",
      "seq": 511012,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap 'echo cleanup:$?' EXIT; eval 'echo nested; exit 3'; echo BAD",
      "expect": {
        "exit": 3,
        "stdout": "nested\ncleanup:3\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_source_return",
      "seq": 511013,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "printf '%s\\n' 'trap '\"'\"'echo cleanup:$?'\"'\"' EXIT' 'echo sourced; return 4; echo BAD' > {mount}/trap-source; source {mount}/trap-source; echo status:$?; exit",
      "expect": {
        "exit": 0,
        "stdout": "sourced\nstatus:4\ncleanup:0\n",
        "stderr": ""
      }
    },
