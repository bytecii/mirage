      "id": "shell_trap_background_exit",
      "seq": 511019,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "{ trap 'echo cleanup:$?' EXIT; echo body; exit 4; } & wait $!; echo status:$?",
      "expect": {
        "exit": 0,
        "stdout": "body\ncleanup:4\nstatus:4\n",
        "stderr": ""
      }
    },
    {
