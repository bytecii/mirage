      "expect": {
        "exit": 1,
        "stdout": "cleanup\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_alias_exit",
      "seq": 511031,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "bash -c 'shopt -s expand_aliases\nalias bye='\"'\"'exit 6'\"'\"'\ntrap '\"'\"'echo cleanup:$?'\"'\"' EXIT\necho body\nbye\necho BAD'",
      "expect": {
