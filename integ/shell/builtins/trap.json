      "seq": 511018,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap 'echo parent' EXIT; { trap 'sleep .01; echo cleanup' EXIT; echo body; } & wait; echo joined; exit",
