      "id": "shell_trap_source_exit",
      "seq": 511014,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "printf '%s\\n' 'echo sourced; exit 6; echo BAD' > {mount}/trap-source; trap 'echo cleanup:$?' EXIT; source {mount}/trap-source; echo BAD",
      "expect": {
        "exit": 6,
        "stdout": "sourced\ncleanup:6\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_function_exit",
      "seq": 511015,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap 'echo cleanup:$?' EXIT; f() { echo function; exit 5; }; f; echo BAD",
      "expect": {
        "exit": 5,
        "stdout": "function\ncleanup:5\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_pipeline",
