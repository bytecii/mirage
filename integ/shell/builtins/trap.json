        "exit": 0,
        "stdout": "body\nchild\nparent\n",
        "stderr": ""
      }
    },
    {
      "id": "shell_trap_pipeline_exit",
      "seq": 511017,
      "targets": [
        "ram",
        "disk",
        "s3",
        "gdrive",
        "redis",
        "opfs"
      ],
      "command": "trap 'echo parent' EXIT; { trap 'echo child:$?' EXIT; echo body; exit 4; } | cat; echo status:$?; exit",
