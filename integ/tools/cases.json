{
  "suite": "tools",
  "description": "Mirage's tool table is one protocol: a case names a tool, gives its JSON input, and pins the answer. Every door runs the same cases in order on a fresh workspace built by setup and must give each answer: in-app (MirageToolOperations.call, both hosts), the HTTP tool routes, the CLI verbs, MCP over HTTP and the SSH mcp subsystem (both daemons). A shell case's answer through POST /shell, mirage shell and ssh exec is the line's stdout, then its stderr, failing when it exits nonzero.",
  "setup": [
    "mkdir -p /src/deep",
    "printf 'Needle\\nhay\\n' > /src/a.py",
    "printf 'needle\\n' > /src/b.txt",
    "printf 'x\\n' > /src/deep/c.py",
    "printf 'a.b\\naxb\\n' > /src/deep/dots.txt",
    "printf '1\\n2\\n3\\n' > /src/deep/three.txt"
  ],
  "cases": [
    {"id": "shell_runs_a_line", "tool": "shell", "input": {"command": "echo hi"}, "expect": {"text": "hi\n", "is_error": false}},
    {"id": "shell_reports_a_failure", "tool": "shell", "input": {"command": "cat /src/none.txt"}, "expect": {"text": "cat: /src/none.txt: No such file or directory\n", "is_error": true}},
    {"id": "read_numbers_lines", "tool": "read", "input": {"path": "/src/a.py"}, "expect": {"text": "     1\tNeedle\n     2\thay\n", "is_error": false}},
    {"id": "read_takes_a_window", "tool": "read", "input": {"path": "/src/a.py", "offset": 1, "limit": 1}, "expect": {"text": "     2\thay\n", "is_error": false}},
    {"id": "read_reports_a_missing_file", "tool": "read", "input": {"path": "/src/none.txt"}, "expect": {"text": "Error: file '/src/none.txt' not found", "is_error": true}},
    {"id": "ls_lists_a_directory", "tool": "ls", "input": {"path": "/src"}, "expect": {"text": "a.py\nb.txt\ndeep\n", "is_error": false}},
    {"id": "grep_searches_recursively", "tool": "grep", "input": {"pattern": "needle", "path": "/src"}, "expect": {"text": "/src/b.txt:1:needle\n", "is_error": false}},
    {"id": "grep_ignores_case_in_included_files", "tool": "grep", "input": {"pattern": "needle", "path": "/src", "ignore_case": true, "include": "*.py"}, "expect": {"text": "/src/a.py:1:Needle\n", "is_error": false}},
    {"id": "grep_names_matching_files", "tool": "grep", "input": {"pattern": "e", "path": "/src", "files_with_matches": true}, "expect": {"text": "/src/a.py\n/src/b.txt\n", "is_error": false}},
    {"id": "grep_counts_matching_lines", "tool": "grep", "input": {"pattern": "e", "path": "/src/a.py", "count": true}, "expect": {"text": "1\n", "is_error": false}},
    {"id": "grep_reads_a_fixed_string", "tool": "grep", "input": {"pattern": "a.b", "path": "/src/deep", "fixed_strings": true}, "expect": {"text": "/src/deep/dots.txt:1:a.b\n", "is_error": false}},
    {"id": "grep_finding_nothing_is_not_an_error", "tool": "grep", "input": {"pattern": "zzz", "path": "/src"}, "expect": {"text": "", "is_error": false}},
    {"id": "glob_matches_any_depth", "tool": "glob", "input": {"pattern": "**/*.py", "path": "/src"}, "expect": {"text": "/src/a.py\n/src/deep/c.py\n", "is_error": false}},
    {"id": "glob_matches_one_level", "tool": "glob", "input": {"pattern": "*.py", "path": "/src"}, "expect": {"text": "/src/a.py\n", "is_error": false}},
    {"id": "glob_takes_an_absolute_pattern", "tool": "glob", "input": {"pattern": "/src/deep/*"}, "expect": {"text": "/src/deep/c.py\n/src/deep/dots.txt\n/src/deep/three.txt\n", "is_error": false}},
    {"id": "write_creates_parents", "tool": "write", "input": {"path": "/out/new.txt", "content": "one\n"}, "expect": {"text": "Written: /out/new.txt", "is_error": false}},
    {"id": "write_refuses_an_unread_file", "tool": "write", "input": {"path": "/src/b.txt", "content": "x\n"}, "expect": {"text": "Error: file '/src/b.txt' exists; read all of it before overwriting it", "is_error": true}},
    {"id": "read_before_overwriting", "tool": "read", "input": {"path": "/src/b.txt"}, "expect": {"text": "     1\tneedle\n", "is_error": false}},
    {"id": "write_overwrites_a_read_file", "tool": "write", "input": {"path": "/src/b.txt", "content": "pin\n"}, "expect": {"text": "Written: /src/b.txt", "is_error": false}},
    {"id": "read_a_few_lines", "tool": "read", "input": {"path": "/src/deep/three.txt", "limit": 1}, "expect": {"text": "     1\t1\n", "is_error": false}},
    {"id": "write_refuses_a_partly_read_file", "tool": "write", "input": {"path": "/src/deep/three.txt", "content": "x\n"}, "expect": {"text": "Error: file '/src/deep/three.txt' exists; read all of it before overwriting it", "is_error": true}},
    {"id": "edit_refuses_an_ambiguous_string", "tool": "edit", "input": {"path": "/src/a.py", "old_string": "e", "new_string": "E"}, "expect": {"text": "Error: string appears 3 times. Pass replace_all=true", "is_error": true}},
    {"id": "edit_replaces_every_occurrence", "tool": "edit", "input": {"path": "/src/a.py", "old_string": "e", "new_string": "E", "replace_all": true}, "expect": {"text": "Edited: /src/a.py (3 occurrence(s))", "is_error": false}},
    {"id": "shell_sees_the_edit", "tool": "shell", "input": {"command": "cat /src/a.py /src/b.txt"}, "expect": {"text": "NEEdlE\nhay\npin\n", "is_error": false}},
    {"id": "shell_moves_a_file_underneath", "tool": "shell", "input": {"command": "echo moved > /src/b.txt"}, "expect": {"text": "", "is_error": false}},
    {"id": "edit_refuses_a_stale_file", "tool": "edit", "input": {"path": "/src/b.txt", "old_string": "moved", "new_string": "x"}, "expect": {"text": "Error: File changed since it was last read: /src/b.txt. Read the file again before modifying it.", "is_error": true}},
    {"id": "shell_links_a_file", "tool": "shell", "input": {"command": "ln -s /src/a.py /src/link.py"}, "expect": {"text": "", "is_error": false}},
    {"id": "glob_follows_a_link_to_a_file", "tool": "glob", "input": {"pattern": "*.py", "path": "/src"}, "expect": {"text": "/src/a.py\n/src/link.py\n", "is_error": false}}
  ]
}
