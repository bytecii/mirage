{
  "cases": [
    {
      "id": "xrf_seed",
      "seq": 963100,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "printf 'b\\na\\n' > /data/xrf.txt && mkdir -p /data2/xrf_dir && echo inner > /data2/xrf_dir/inner.txt && echo ok",
      "expect": {
        "exit": 0,
        "stdout": "ok\n",
        "stderr": ""
      }
    },
    {
      "id": "xrf_sort",
      "seq": 963101,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "sort /data/xrf.txt /data2/xrf_nope.txt",
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": "sort: cannot read: /data2/xrf_nope.txt: No such file or directory\n"
      }
    },
    {
      "id": "xrf_sed",
      "seq": 963102,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "sed -n p /data/xrf.txt /data2/xrf_nope.txt",
      "expect": {
        "exit": 2,
        "stdout": "b\na\n",
        "stderr": "sed: /data2/xrf_nope.txt: No such file or directory\n"
      }
    },
    {
      "id": "xrf_awk",
      "seq": 963103,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "awk '{print}' /data/xrf.txt /data2/xrf_nope.txt",
      "expect": {
        "exit": 2,
        "stdout": "b\na\n",
        "stderr": "awk: /data2/xrf_nope.txt: No such file or directory\n"
      }
    },
    {
      "id": "xrf_cat",
      "seq": 963104,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "cat /data/xrf.txt /data2/xrf_nope.txt",
      "expect": {
        "exit": 1,
        "stdout": "b\na\n",
        "stderr": "cat: /data2/xrf_nope.txt: No such file or directory\n"
      }
    },
    {
      "id": "xrf_wc",
      "seq": 963105,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "wc -l /data/xrf.txt /data2/xrf_nope.txt",
      "expect": {
        "exit": 1,
        "stdout": "2 /data/xrf.txt\n2 total\n",
        "stderr": "wc: /data2/xrf_nope.txt: No such file or directory\n"
      }
    },
    {
      "id": "xrf_sed_dir",
      "seq": 963106,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "sed -n p /data/xrf.txt /data2/xrf_dir",
      "expect": {
        "exit": 4,
        "stdout": "b\na\n",
        "stderr": "sed: /data2/xrf_dir: Is a directory\n"
      }
    },
    {
      "id": "xrf_sort_dir",
      "seq": 963107,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "sort /data/xrf.txt /data2/xrf_dir",
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": "sort: read failed: /data2/xrf_dir: Is a directory\n"
      }
    },
    {
      "id": "xrf_cat_dir",
      "seq": 963108,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "cat /data/xrf.txt /data2/xrf_dir",
      "expect": {
        "exit": 1,
        "stdout": "b\na\n",
        "stderr": "cat: /data2/xrf_dir: Is a directory\n"
      }
    },
    {
      "id": "xrf_seed_named_dir",
      "seq": 963109,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "mkdir -p '/data2/No such file or directory' && echo ok",
      "expect": {
        "exit": 0,
        "stdout": "ok\n",
        "stderr": ""
      }
    },
    {
      "id": "xrf_sed_dir_named_for_another_errno",
      "seq": 963110,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "sed -n p /data/xrf.txt '/data2/No such file or directory'",
      "expect": {
        "exit": 4,
        "stdout": "b\na\n",
        "stderr": "sed: '/data2/No such file or directory': Is a directory\n"
      }
    }
  ]
}
