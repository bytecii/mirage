{
  "cases": [
    {
      "id": "git_init_independent_repository",
      "seq": 568800,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git init -q -b main /repo/empty-repo && cat /repo/empty-repo/.git/HEAD",
      "expect": {
        "exit": 0,
        "stdout": "ref: refs/heads/main\n",
        "stderr": ""
      }
    },
    {
      "id": "git_reinit_preserves_head",
      "seq": 568801,
      "targets": [
        "git-disk",
        "git-ram"
      ],
      "command": "git init -q -b ignored /repo/empty-repo && cat /repo/empty-repo/.git/HEAD",
      "expect": {
        "exit": 0,
        "stdout": "ref: refs/heads/main\n",
        "stderr": "warning: re-init: ignored --initial-branch=ignored\n"
      }
    },
    {
      "id": "git_stash_empty_list",
